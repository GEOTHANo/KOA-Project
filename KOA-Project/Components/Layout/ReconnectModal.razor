<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="koa-reconnect-overlay">
        <!-- Animated background rings -->
        <div class="koa-bg-ring koa-bg-ring-1"></div>
        <div class="koa-bg-ring koa-bg-ring-2"></div>
        <div class="koa-bg-ring koa-bg-ring-3"></div>

        <div class="koa-reconnect-card">
            <!-- Logo with pulse animation -->
            <div class="koa-logo-wrapper">
                <div class="koa-logo-ring koa-logo-ring-outer"></div>
                <div class="koa-logo-ring koa-logo-ring-inner"></div>
                <div class="koa-logo-container">
                    <img src="/images/koa-logo.jpg" alt="KOA Logo" class="koa-logo-img" />
                </div>
            </div>

            <!-- Reconnecting state -->
            <div class="koa-status-block components-reconnect-first-attempt-visible components-reconnect-repeated-attempt-visible">
                <h2 class="koa-title">Reconnecting</h2>
                <p class="koa-subtitle components-reconnect-first-attempt-visible">Attempting to reconnect to the server...</p>
                <p class="koa-subtitle components-reconnect-repeated-attempt-visible">
                    Retrying in <span id="components-seconds-to-next-attempt" class="koa-countdown"></span>s...
                </p>
                <div class="koa-dots">
                    <span></span><span></span><span></span>
                </div>
            </div>

            <!-- Failed state -->
            <div class="koa-status-block components-reconnect-failed-visible">
                <div class="koa-fail-icon">!</div>
                <h2 class="koa-title">Connection Lost</h2>
                <p class="koa-subtitle">Unable to reconnect to the server.</p>
                <button id="components-reconnect-button" class="koa-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
                    Try Again
                </button>
            </div>

            <!-- Paused state -->
            <div class="koa-status-block components-pause-visible">
                <h2 class="koa-title">Session Paused</h2>
                <p class="koa-subtitle">The session has been paused by the server.</p>
                <button id="components-resume-button" class="koa-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    Resume
                </button>
            </div>

            <!-- Resume failed state -->
            <div class="koa-status-block components-resume-failed-visible">
                <div class="koa-fail-icon">!</div>
                <h2 class="koa-title">Resume Failed</h2>
                <p class="koa-subtitle">Failed to resume the session.<br/>Please retry or reload the page.</p>
            </div>

            <p class="koa-brand">Knights of the Altar &mdash; Sto. Rosario Toril</p>
        </div>
    </div>
</dialog>
