@inject LiturgicalCalendarService LitCal
@inject IJSRuntime JS

@if (_loading)
{
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-gray-200/80 dark:border-slate-800 shadow-sm p-6 animate-pulse">
        <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-gray-200 dark:bg-slate-800 rounded-xl"></div>
            <div class="flex-1 space-y-2">
                <div class="h-4 bg-gray-200 dark:bg-slate-800 rounded w-3/4"></div>
                <div class="h-3 bg-gray-100 dark:bg-slate-800/60 rounded w-1/2"></div>
            </div>
        </div>
        <div class="space-y-2">
            <div class="h-3 bg-gray-100 dark:bg-slate-800/60 rounded"></div>
            <div class="h-3 bg-gray-100 dark:bg-slate-800/60 rounded w-5/6"></div>
            <div class="h-3 bg-gray-100 dark:bg-slate-800/60 rounded w-4/6"></div>
        </div>
    </div>
}
else if (_error)
{
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-red-100 dark:border-red-950/50 shadow-sm p-6">
        <div class="flex items-center gap-3 mb-3">
            <div class="bg-red-50 dark:bg-red-950/50 p-2.5 rounded-xl">
                <i data-lucide="wifi-off" class="w-5 h-5 text-red-500"></i>
            </div>
            <div>
                <h3 class="font-bold text-gray-800 dark:text-slate-100 text-sm">Today's Mass Readings</h3>
                <p class="text-xs text-gray-400 dark:text-slate-500">@DateTime.Now.ToString("MMMM dd, yyyy")</p>
            </div>
        </div>
        <p class="text-xs text-red-500 mb-3">Unable to load liturgical data.</p>
        <button @onclick="LoadAsync" class="text-xs text-[#1e5c8a] dark:text-blue-400 hover:underline font-semibold flex items-center gap-1">
            <i data-lucide="refresh-cw" class="w-3 h-3"></i> Try Again
        </button>
    </div>
}
else if (_event == null)
{
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-gray-200/80 dark:border-slate-800 shadow-sm p-6">
        <div class="flex items-center gap-3 mb-4 pb-3 border-b border-gray-100 dark:border-slate-800">
            <div class="bg-blue-50 dark:bg-blue-950/60 p-2.5 rounded-xl">
                <i data-lucide="cross" class="w-5 h-5 text-[#1e5c8a] dark:text-blue-400"></i>
            </div>
            <div>
                <h3 class="font-bold text-gray-800 dark:text-slate-100 text-sm">Today's Mass Readings</h3>
                <p class="text-xs text-gray-400 dark:text-slate-500">@DateTime.Now.ToString("MMMM dd, yyyy")</p>
            </div>
        </div>
        <p class="text-xs text-gray-400 dark:text-slate-500 text-center py-4">No specific celebration found for today.</p>
    </div>
}
else
{
    var litColor = _event.PrimaryColor;
    var (accentBg, accentText, accentBorder) = litColor switch
    {
        "purple" => ("bg-purple-50 dark:bg-purple-950/50", "text-purple-700 dark:text-purple-300", "border-purple-200 dark:border-purple-800"),
        "white"  => ("bg-sky-50 dark:bg-sky-950/50",       "text-sky-700 dark:text-sky-300",       "border-sky-200 dark:border-sky-800"),
        "red"    => ("bg-red-50 dark:bg-red-950/50",       "text-red-700 dark:text-red-300",       "border-red-200 dark:border-red-800"),
        "rose"   => ("bg-pink-50 dark:bg-pink-950/50",     "text-pink-700 dark:text-pink-300",     "border-pink-200 dark:border-pink-800"),
        _        => ("bg-emerald-50 dark:bg-emerald-950/50", "text-emerald-700 dark:text-emerald-300", "border-emerald-200 dark:border-emerald-800"),
    };
    var colorDot = litColor switch
    {
        "purple" => "bg-purple-500",
        "white"  => "bg-sky-400",
        "red"    => "bg-red-500",
        "rose"   => "bg-pink-400",
        _        => "bg-emerald-500",
    };
    var readings = _event.GetSimpleReadings();

    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-gray-200/80 dark:border-slate-800 shadow-sm p-6 flex flex-col transition-colors duration-200">
        <!-- Header -->
        <div class="flex items-start gap-3 mb-4 pb-3 border-b border-gray-100 dark:border-slate-800">
            <div class="@accentBg p-2.5 rounded-xl shrink-0">
                <i data-lucide="cross" class="w-5 h-5 @accentText"></i>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="font-bold text-gray-800 dark:text-slate-100 text-sm">Today's Mass</h3>
                    <span class="@colorDot w-2.5 h-2.5 rounded-full inline-block" title="Liturgical color: @litColor"></span>
                    @if (_event.HolyDayOfObligation == true)
                    {
                        <span class="bg-yellow-100 dark:bg-yellow-950/80 text-yellow-800 dark:text-yellow-300 text-[10px] font-bold px-1.5 py-0.5 rounded uppercase tracking-wide">Holy Day</span>
                    }
                    @if (_event.IsVigilMass == true)
                    {
                        <span class="bg-indigo-100 dark:bg-indigo-950/80 text-indigo-800 dark:text-indigo-300 text-[10px] font-bold px-1.5 py-0.5 rounded uppercase tracking-wide">Vigil</span>
                    }
                </div>
                <p class="text-xs text-gray-400 dark:text-slate-500 mt-0.5">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
            </div>
        </div>

        <!-- Celebration -->
        <div class="mb-3">
            <p class="font-bold text-gray-800 dark:text-slate-100 text-sm leading-snug">@_event.Name</p>
            <div class="flex flex-wrap gap-1.5 mt-1.5">
                <span class="@accentBg @accentText text-[11px] font-medium px-2 py-0.5 rounded-full border @accentBorder">
                    @_event.SeasonDisplay
                </span>
                @if (!string.IsNullOrWhiteSpace(_event.GradeDisplay))
                {
                    <span class="bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 text-[11px] font-medium px-2 py-0.5 rounded-full">
                        @_event.GradeDisplay
                    </span>
                }
            </div>
        </div>

        <!-- Readings -->
        @if (readings != null && readings.Any())
        {
            <div class="space-y-1.5 flex-1">
                <p class="text-[11px] font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider">Readings</p>
                @foreach (var (key, citation) in readings)
                {
                    var label = key switch
                    {
                        "first_reading"       => "1st Reading",
                        "responsorial_psalm"  => "Psalm",
                        "second_reading"      => "2nd Reading",
                        "gospel_acclamation"  => "Acclamation",
                        "gospel"              => "Gospel",
                        _                     => key
                    };
                    <div class="flex items-start gap-2 text-xs">
                        <span class="text-gray-400 dark:text-slate-500 w-24 shrink-0 pt-0.5">@label</span>
                        <span class="font-semibold @accentText">@citation</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex-1 flex items-center justify-center py-3">
                <p class="text-xs text-gray-400 dark:text-slate-500 italic text-center">Readings are from the Common or Proper &mdash; see the Lectionary.</p>
            </div>
        }

        <!-- Footer -->
        <div class="mt-4 pt-3 border-t border-gray-100 dark:border-slate-800">
            <a href="https://litcal.johnromanodorazio.com" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-1.5 text-xs font-semibold @accentText hover:underline">
                <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                View Full Liturgical Calendar
            </a>
        </div>
    </div>
}

@code {
    private LiturgicalEvent? _event;
    private bool _loading = true;
    private bool _error = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("initLucide"); } catch { }
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        StateHasChanged();

        try
        {
            _event = await LitCal.GetTodayAsync();
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
            try { await JS.InvokeVoidAsync("initLucide"); } catch { }
        }
    }
}