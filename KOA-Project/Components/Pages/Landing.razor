@page "/"
@layout KOA_Project.Components.Layout.EmptyLayout
@implements IDisposable
@inject NavigationManager Nav
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject VaticanNewsService NewsService

<PageTitle>Knights of the Altar - Sto. Rosario Parish Toril</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100 font-sans selection:bg-[#246b9c] selection:text-white flex flex-col">
    <!-- Fixed / Sticky Header Navigation -->
    <header class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md border-b border-slate-800/80 shadow-md transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-2">
            <!-- Brand Logo (Transparent background, no white card) & Title -->
            <a href="/" class="flex items-center space-x-3 group min-w-0">
                <img src="/images/koa-logo.jpg" alt="KOA Logo" class="w-10 h-10 sm:w-11 sm:h-11 object-cover rounded-xl shadow-md group-hover:scale-105 transition-transform duration-300 shrink-0" />
                <div class="flex flex-col min-w-0">
                    <span class="text-base sm:text-lg font-extrabold tracking-tight text-white group-hover:text-[#3892d0] transition-colors truncate">Knights of the Altar</span>
                    <span class="text-[9px] sm:text-[10px] font-semibold text-slate-400 tracking-wider uppercase truncate">Sto. Rosario Parish &bull; Toril</span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-300 shrink-0">
                <a href="#liturgical" class="hover:text-white transition-colors">Liturgical Calendar</a>
                <a href="#birthdays" class="hover:text-white transition-colors">Birthdays</a>
                <a href="#about" class="hover:text-white transition-colors">About Gallery</a>
                <a href="#vatican-news" class="hover:text-white transition-colors">Catholic News</a>
            </nav>

            <!-- Actions (Login & Register Buttons) -->
            <div class="flex items-center space-x-2 sm:space-x-3 shrink-0">
                <!-- Register Button -->
                <a href="/register" 
                   class="inline-flex items-center space-x-2 bg-amber-500 hover:bg-amber-600 text-white px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-md transition-all transform hover:-translate-y-0.5 border border-amber-400/30" title="Register New Member">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>
                    <span class="hidden sm:inline">Register</span>
                </a>

                <!-- Log In Button (Icon Only on Mobile < 640px) -->
                <a href="/login" 
                   class="inline-flex items-center space-x-2 bg-[#246b9c] hover:bg-[#1b557d] text-white px-3 sm:px-5 py-2 sm:py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-md shadow-[#246b9c]/20 hover:shadow-lg transition-all transform hover:-translate-y-0.5 border border-blue-400/30" title="Log In to System">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                    </svg>
                    <span class="hidden sm:inline">Log In</span>
                </a>

                <button type="button" @onclick="ToggleMobileMenu" class="md:hidden p-2 text-slate-400 hover:text-white focus:outline-none">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
                    </svg>
                </button>
            </div>
        </div>

        @if (_isMobileMenuOpen)
        {
            <div class="md:hidden bg-slate-900 border-b border-slate-800 px-4 pt-3 pb-5 space-y-3 font-medium text-sm">
                <a href="#liturgical" @onclick="CloseMobileMenu" class="block py-2 text-slate-200 hover:text-white">Liturgical Calendar</a>
                <a href="#birthdays" @onclick="CloseMobileMenu" class="block py-2 text-slate-200 hover:text-white">Birthdays</a>
                <a href="#about" @onclick="CloseMobileMenu" class="block py-2 text-slate-200 hover:text-white">About Gallery</a>
                <a href="#vatican-news" @onclick="CloseMobileMenu" class="block py-2 text-slate-200 hover:text-white">Catholic News</a>
                <div class="grid grid-cols-2 gap-2 pt-2">
                    <a href="/register" class="inline-flex items-center justify-center space-x-1.5 bg-amber-500 text-white py-2.5 rounded-xl font-bold text-xs">
                        <span>Register</span>
                    </a>
                    <a href="/login" class="inline-flex items-center justify-center space-x-1.5 bg-[#246b9c] text-white py-2.5 rounded-xl font-bold text-xs">
                        <span>Log In</span>
                    </a>
                </div>
            </div>
        }
    </header>

    <!-- Main Hero Section -->
    <section class="relative overflow-hidden pt-16 pb-20 lg:pt-24 lg:pb-28 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950">
        <div class="absolute inset-0 bg-[radial-gradient(#246b9c_1px,transparent_1px)] [background-size:32px_32px] opacity-15 pointer-events-none"></div>
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[#246b9c]/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/4 right-10 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-6 space-y-8 text-center lg:text-left">
                    <div class="inline-flex items-center space-x-2 bg-slate-900/90 border border-amber-500/30 px-4 py-2 rounded-full text-xs font-semibold text-amber-400 backdrop-blur-sm shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                        <span>Knights of the Altar &bull; Sto. Rosario Parish Toril</span>
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-none">
                        Brave Hearts <br />
                        <span class="bg-gradient-to-r from-[#4ca3e0] via-[#246b9c] to-amber-300 bg-clip-text text-transparent">Pure Service</span>
                    </h1>

                    <p class="text-base sm:text-lg text-slate-300 max-w-xl mx-auto lg:mx-0 font-normal leading-relaxed">
                        Manage mass scheduling, attendance, and liturgical services for Knights of the Altar at Sto. Rosario Parish, Toril.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
                        <a href="/login" 
                           class="w-full sm:w-auto inline-flex items-center justify-center space-x-3 bg-[#246b9c] hover:bg-[#1a547b] text-white px-8 py-4 rounded-2xl font-extrabold text-base shadow-xl shadow-[#246b9c]/25 hover:shadow-2xl hover:shadow-[#246b9c]/40 transition-all transform hover:-translate-y-1 border border-blue-400/20">
                            <span>Log In to System</span>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>

                        <a href="/register" 
                           class="w-full sm:w-auto inline-flex items-center justify-center space-x-3 bg-amber-500/90 hover:bg-amber-600 text-white px-8 py-4 rounded-2xl font-extrabold text-base shadow-xl transition-all transform hover:-translate-y-1 border border-amber-400/30">
                            <span>Register as Member</span>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>
                        </a>
                    </div>
                </div>

                <!-- Liturgical Card Widget -->
                <div class="lg:col-span-6 flex justify-center lg:justify-end">
                    <div class="w-full max-w-lg shadow-2xl rounded-3xl overflow-hidden border border-slate-800 bg-slate-900/90 backdrop-blur-md">
                        <div class="p-4 bg-slate-900 border-b border-slate-800 flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                <span class="w-3 h-3 rounded-full bg-amber-400"></span>
                                <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Today's Liturgical Calendar</span>
                            </div>
                            <span class="text-[10px] text-slate-500 font-mono">LitCal API</span>
                        </div>
                        <div class="p-2">
                            <KOA_Project.Components.Shared.LiturgicalCard />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Birthdays Section -->
    <section id="birthdays" class="py-16 bg-slate-900 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8 gap-4">
                <div>
                    <div class="inline-flex items-center space-x-2 text-rose-400 text-xs font-bold uppercase tracking-wider mb-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-1.5-.454M9 6v2m3-2v2m3-2v2M9 3h.01M12 3h.01M15 3h.01M3 21h18M3 10h18M3 7l9-4 9 4v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/></svg>
                        <span>Ministry Celebrations</span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-black text-white">Birthdays This Month</h2>
                    <p class="text-xs sm:text-sm text-slate-400 mt-1">Celebrating our brothers in service born in @DateTime.Now.ToString("MMMM").</p>
                </div>
                <div class="bg-slate-800 px-4 py-2 rounded-xl border border-slate-700 text-xs text-amber-400 font-bold">
                    @DateTime.Now.ToString("MMMM yyyy")
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                @if (!_birthdaysThisMonth.Any())
                {
                    <div class="col-span-full py-12 text-center text-slate-500 bg-slate-950/50 rounded-2xl border border-slate-800">
                        <p class="text-sm">No birthdays listed for @DateTime.Now.ToString("MMMM").</p>
                    </div>
                }
                @foreach (var m in _birthdaysThisMonth)
                {
                    var daysLeft = m.BirthDate.HasValue ? m.BirthDate.Value.Day - DateTime.Now.Day : 0;
                    var badgeStyle = daysLeft == 0 ? "bg-emerald-500/20 text-emerald-300 border-emerald-500/40" : daysLeft > 0 ? "bg-[#246b9c]/20 text-blue-300 border-blue-500/40" : "bg-slate-800 text-slate-400 border-slate-700";
                    var badgeText = daysLeft == 0 ? "Today!" : daysLeft > 0 ? $"In {daysLeft}d" : "Passed";

                    <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-4 flex items-center justify-between hover:border-slate-700 transition-all">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-amber-500 text-white font-bold flex items-center justify-center text-xs shadow-md">
                                @m.Initials
                            </div>
                            <div>
                                <h3 class="font-bold text-white text-sm">@m.FirstName @m.LastName</h3>
                                <p class="text-xs text-slate-400">@(m.BirthDate?.ToString("MMMM dd"))</p>
                            </div>
                        </div>
                        <span class="text-[10px] font-bold px-2.5 py-1 rounded-full border @badgeStyle">
                            @badgeText
                        </span>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- About Photo Gallery Carousel Section -->
    <section id="about" class="py-20 bg-slate-950 border-t border-slate-800 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <div class="inline-flex items-center space-x-2 text-[#3892d0] text-xs font-bold uppercase tracking-wider mb-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 002-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    <span>Ministry Gallery</span>
                </div>
                <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">Knights of the Altar in Action</h2>
                <p class="text-xs sm:text-sm text-slate-400 mt-2">Serving at the Table of the Lord at Sto. Rosario Parish &bull; Toril</p>
            </div>

            <!-- Endless Photo Carousel Component -->
            @if (_galleryPhotos.Any())
            {
                <div class="relative group max-w-5xl mx-auto" @onmouseenter="PauseGalleryTimer" @onmouseleave="ResumeGalleryTimer">
                    <!-- Main Slide Box -->
                    <div class="relative h-[350px] sm:h-[480px] lg:h-[560px] rounded-3xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900">
                        <img src="@_galleryPhotos[_galleryIndex]" alt="KOA Gallery Photo" class="w-full h-full object-cover transition-all duration-700 transform scale-100 hover:scale-105" />
                        
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>

                        <!-- Info Overlay -->
                        <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between">
                            <div>
                                <span class="bg-[#246b9c]/80 backdrop-blur-md text-white text-[10px] font-bold px-3 py-1 rounded-full border border-blue-400/30 uppercase tracking-wider">
                                    Photo @(_galleryIndex + 1) of @_galleryPhotos.Count
                                </span>
                                <h3 class="text-lg sm:text-xl font-bold text-white mt-2">Sto. Rosario Parish Altar Ministry</h3>
                            </div>
                            
                            <!-- Navigation Arrows -->
                            <div class="flex items-center space-x-2">
                                <button type="button" @onclick="PrevGallerySlide" class="p-3 rounded-full bg-slate-900/80 hover:bg-[#246b9c] text-white border border-slate-700/80 backdrop-blur-md transition-all">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
                                </button>
                                <button type="button" @onclick="NextGallerySlide" class="p-3 rounded-full bg-slate-900/80 hover:bg-[#246b9c] text-white border border-slate-700/80 backdrop-blur-md transition-all">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Pagination Dots -->
                    <div class="flex items-center justify-center space-x-2 mt-6 overflow-x-auto py-2">
                        @for (int i = 0; i < Math.Min(_galleryPhotos.Count, 15); i++)
                        {
                            var idx = i;
                            <button type="button" @onclick="() => GoToGallerySlide(idx)" 
                                    class="h-2 rounded-full transition-all duration-300 @(idx == _galleryIndex ? "w-8 bg-amber-400" : "w-2 bg-slate-700 hover:bg-slate-500")"></button>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Vatican News Endless Carousel Section -->
    <section id="vatican-news" class="py-20 bg-slate-900 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-10 gap-4">
                <div>
                    <div class="inline-flex items-center space-x-2 text-amber-400 text-xs font-bold uppercase tracking-wider mb-1">
                        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                        <span>Vatican RSS Feed</span>
                    </div>
                    <h2 class="text-3xl font-black text-white">Catholic & Vatican News Updates</h2>
                    <p class="text-xs sm:text-sm text-slate-400 mt-1">Live news stories from the Holy See & Catholic World.</p>
                </div>

                <div class="flex items-center space-x-2">
                    <button type="button" @onclick="PrevNewsSlide" class="p-3 rounded-xl bg-slate-800 hover:bg-[#246b9c] text-white border border-slate-700 transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                    </button>
                    <button type="button" @onclick="NextNewsSlide" class="p-3 rounded-xl bg-slate-800 hover:bg-[#246b9c] text-white border border-slate-700 transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>

            @if (_newsItems == null || !_newsItems.Any())
            {
                <div class="p-12 text-center text-slate-500 bg-slate-950/60 rounded-3xl border border-slate-800">
                    <p class="text-sm">Fetching latest Vatican News...</p>
                </div>
            }
            else
            {
                var visibleNews = GetVisibleNewsItems();
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" @onmouseenter="PauseNewsTimer" @onmouseleave="ResumeNewsTimer">
                    @foreach (var news in visibleNews)
                    {
                        <a href="@news.Link" target="_blank" rel="noopener noreferrer" 
                           class="bg-slate-950/90 border border-slate-800 hover:border-[#246b9c] rounded-3xl p-6 flex flex-col justify-between hover:shadow-2xl transition-all group transform hover:-translate-y-1">
                            <div class="space-y-3">
                                <div class="flex items-center justify-between text-[11px] text-slate-400">
                                    <span class="bg-[#246b9c]/20 text-blue-300 font-bold px-2.5 py-0.5 rounded-full border border-blue-500/30">Vatican News</span>
                                    <span>@news.PublishDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <h3 class="text-base font-bold text-white group-hover:text-[#3892d0] transition-colors leading-snug">@news.Title</h3>
                                <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">@news.Summary</p>
                            </div>
                            <div class="pt-4 border-t border-slate-800/80 mt-4 flex items-center justify-between text-xs font-bold text-[#3892d0] group-hover:text-white">
                                <span>Read Full Story</span>
                                <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-slate-800 py-12 text-slate-400 text-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center space-x-3">
                <img src="/images/koa-logo.jpg" alt="KOA Logo" class="w-8 h-8 object-cover rounded-lg" />
                <span class="font-bold text-white text-sm">Knights of the Altar &bull; Sto. Rosario Parish Toril</span>
            </div>
            <p class="text-center md:text-right text-slate-500">
                &copy; @DateTime.Now.Year Knights of the Altar Ministry. All rights reserved. &bull; <i>"Ave Maria, Gratia Plena"</i>
            </p>
        </div>
    </footer>
</div>

@code {
    private List<Member> _birthdaysThisMonth = new();
    private List<string> _galleryPhotos = new();
    private int _galleryIndex = 0;
    private System.Threading.Timer? _galleryTimer;

    private List<VaticanNewsItem> _newsItems = new();
    private int _newsIndex = 0;
    private System.Threading.Timer? _newsTimer;

    private bool _isMobileMenuOpen = false;

    private void ToggleMobileMenu() => _isMobileMenuOpen = !_isMobileMenuOpen;
    private void CloseMobileMenu() => _isMobileMenuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var currentMonth = DateTime.Now.Month;
        var activeMembers = await db.Members
            .Where(m => m.Status == "Active" && m.BirthDate != null)
            .ToListAsync();
        _birthdaysThisMonth = activeMembers
            .Where(m => m.BirthDate!.Value.Month == currentMonth)
            .OrderBy(m => m.BirthDate!.Value.Day)
            .ToList();

        // Load KOA Photos
        var webRoot = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", "koa-photos");
        if (Directory.Exists(webRoot))
        {
            var files = Directory.GetFiles(webRoot, "*.*")
                .Where(f => f.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                            f.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                            f.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                            f.EndsWith(".webp", StringComparison.OrdinalIgnoreCase))
                .Select(f => "/images/koa-photos/" + Path.GetFileName(f))
                .ToList();
            _galleryPhotos = files;
        }

        // Vatican News
        _newsItems = await NewsService.GetLatestNewsAsync();

        // Start Auto Carousels
        StartGalleryTimer();
        StartNewsTimer();
    }

    // Gallery Carousel Logic
    private void StartGalleryTimer()
    {
        _galleryTimer?.Dispose();
        _galleryTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                NextGallerySlide();
                StateHasChanged();
            });
        }, null, 4000, 4000);
    }

    private void PauseGalleryTimer() => _galleryTimer?.Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
    private void ResumeGalleryTimer() => _galleryTimer?.Change(4000, 4000);

    private void NextGallerySlide()
    {
        if (!_galleryPhotos.Any()) return;
        _galleryIndex = (_galleryIndex + 1) % _galleryPhotos.Count;
    }

    private void PrevGallerySlide()
    {
        if (!_galleryPhotos.Any()) return;
        _galleryIndex = (_galleryIndex - 1 + _galleryPhotos.Count) % _galleryPhotos.Count;
    }

    private void GoToGallerySlide(int index) => _galleryIndex = index;

    // News Carousel Logic
    private void StartNewsTimer()
    {
        _newsTimer?.Dispose();
        _newsTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                NextNewsSlide();
                StateHasChanged();
            });
        }, null, 6000, 6000);
    }

    private void PauseNewsTimer() => _newsTimer?.Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
    private void ResumeNewsTimer() => _newsTimer?.Change(6000, 6000);

    private void NextNewsSlide()
    {
        if (!_newsItems.Any()) return;
        _newsIndex = (_newsIndex + 3) % _newsItems.Count;
    }

    private void PrevNewsSlide()
    {
        if (!_newsItems.Any()) return;
        _newsIndex = (_newsIndex - 3 + _newsItems.Count) % _newsItems.Count;
    }

    private List<VaticanNewsItem> GetVisibleNewsItems()
    {
        if (!_newsItems.Any()) return new();
        var visible = new List<VaticanNewsItem>();
        for (int i = 0; i < 3; i++)
        {
            var idx = (_newsIndex + i) % _newsItems.Count;
            visible.Add(_newsItems[idx]);
        }
        return visible;
    }

    public void Dispose()
    {
        _galleryTimer?.Dispose();
        _newsTimer?.Dispose();
    }
}
