@page "/members/{Id:long}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "members")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Edit Member - Knights of the Altar</PageTitle>

@if (_member == null)
{
    <div class="flex items-center justify-center py-16 text-gray-400 dark:text-slate-500">
        <i data-lucide="loader-2" class="w-6 h-6 animate-spin mr-2"></i> Loading member details...
    </div>
}
else
{
<div class="space-y-6 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div class="flex items-center">
            <a href="/members/@_member.Id" class="text-gray-400 dark:text-slate-500 hover:text-gray-600 dark:hover:text-slate-200 mr-3 transition-colors">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Edit Member</h1>
                <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Update @_member.FullName's information</p>
            </div>
        </div>
    </div>

    @if (_errors.Any())
    {
        <div class="bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300 p-4 rounded-xl text-sm space-y-1">
            @foreach (var err in _errors)
            {
                <p class="flex items-center gap-1.5"><i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i> @err</p>
            }
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="space-y-6">
        <!-- Account Info -->
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm p-6">
            <h3 class="text-sm font-semibold text-gray-700 dark:text-slate-300 mb-4 pb-2 border-b border-gray-100 dark:border-slate-700 flex items-center gap-2">
                <i data-lucide="lock" class="w-4 h-4 text-[#246b9c] dark:text-blue-400"></i> Account Credentials
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Username <span class="text-red-500">*</span></label>
                    <InputText @bind-Value="_model.Username" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-700 dark:bg-slate-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-[#246b9c] outline-none" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">New Password (leave blank to keep)</label>
                    <InputText type="password" @bind-Value="_model.Password" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-700 dark:bg-slate-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-[#246b9c] outline-none" />
                </div>
            </div>
        </div>

        <!-- Personal Info -->
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm p-6">
            <h3 class="text-sm font-semibold text-gray-700 dark:text-slate-300 mb-4 pb-2 border-b border-gray-100 dark:border-slate-700 flex items-center gap-2">
                <i data-lucide="user" class="w-4 h-4 text-[#246b9c] dark:text-blue-400"></i> Personal Information
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">First Name <span class="text-red-500">*</span></label>
                    <InputText @bind-Value="_model.FirstName" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-700 dark:bg-slate-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-[#246b9c] outline-none" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Middle Name</label>
                    <InputText @bind-Value="_model.MiddleName" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-700 dark:bg-slate-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-[#246b9c] outline-none" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Last Name <span class="text-red-500">*</span></label>
                    <InputText @bind-Value="_model.LastName" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-700 dark:bg-slate-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-[#246b9c] outline-none" />
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Contact Number</label>
                    <InputText @bind-Value="_model.ContactNumber" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-700 dark:bg-slate-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-[#246b9c] outline-none" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Birthday</label>
                    <InputDate @bind-Value="_model.BirthDate" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-700 dark:bg-slate-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-[#246b9c] outline-none" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Status <span class="text-red-500">*</span></label>
                    <InputSelect @bind-Value="_model.Status" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-700 dark:bg-slate-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-[#246b9c] outline-none">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Alumni">Alumni</option>
                    </InputSelect>
                </div>
            </div>
        </div>

        <!-- Position(s) -->
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm p-6">
            <h3 class="text-sm font-semibold text-gray-700 dark:text-slate-300 mb-4 pb-2 border-b border-gray-100 dark:border-slate-700 flex items-center gap-2">
                <i data-lucide="shield" class="w-4 h-4 text-[#246b9c] dark:text-blue-400"></i> Position(s)
            </h3>
            <div class="flex flex-wrap gap-2">
                @foreach (var position in _availablePositions)
                {
                    <label class="inline-flex items-center bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-lg px-3 py-1.5 cursor-pointer hover:bg-blue-50 dark:hover:bg-slate-700 transition-colors">
                        <input type="checkbox" checked="@_model.SelectedPositionIds.Contains(position.Id)"
                               @onchange="@(e => TogglePosition(position.Id, e.Value))"
                               class="mr-2 rounded border-gray-300 dark:border-slate-700 text-[#246b9c] focus:ring-[#246b9c]" />
                        <span class="text-sm text-gray-800 dark:text-slate-200">@position.PositionName</span>
                    </label>
                }
            </div>
        </div>

        <div class="flex items-center justify-end space-x-3">
            <a href="/members/@_member.Id" class="px-5 py-2.5 text-sm font-medium text-gray-700 dark:text-slate-300 bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-700 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors">Cancel</a>
            <button type="submit" class="px-5 py-2.5 text-sm font-semibold text-white bg-[#246b9c] hover:bg-[#1a547b] rounded-xl transition-colors shadow-sm flex items-center gap-2">
                <i data-lucide="save" class="w-4 h-4"></i> Update Member
            </button>
        </div>
    </EditForm>
</div>
}

@code {
    [Parameter] public long Id { get; set; }
    
    private Member? _member;
    private MemberEditModel _model = new();
    private List<Position> _availablePositions = new();
    private List<string> _errors = new();

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        
        _member = await db.Members
            .Include(m => m.MemberPositions)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (_member == null)
        {
            Nav.NavigateTo("/members");
            return;
        }

        _availablePositions = await db.Positions.ToListAsync();

        _model = new MemberEditModel
        {
            Username = _member.Username,
            FirstName = _member.FirstName,
            MiddleName = _member.MiddleName,
            LastName = _member.LastName,
            ContactNumber = _member.ContactNumber,
            BirthDate = _member.BirthDate,
            Status = _member.Status,
            SelectedPositionIds = _member.MemberPositions
                .Where(mp => mp.IsCurrent)
                .Select(mp => mp.PositionId)
                .ToList()
        };
    }

    private void TogglePosition(long positionId, object? checkedValue)
    {
        bool isChecked = (bool?)checkedValue ?? false;
        if (isChecked && !_model.SelectedPositionIds.Contains(positionId))
        {
            _model.SelectedPositionIds.Add(positionId);
        }
        else if (!isChecked && _model.SelectedPositionIds.Contains(positionId))
        {
            _model.SelectedPositionIds.Remove(positionId);
        }
    }

    private async Task HandleSubmit()
    {
        _errors.Clear();
        if (string.IsNullOrWhiteSpace(_model.Username)) _errors.Add("Username is required.");
        if (string.IsNullOrWhiteSpace(_model.FirstName)) _errors.Add("First Name is required.");
        if (string.IsNullOrWhiteSpace(_model.LastName)) _errors.Add("Last Name is required.");

        if (_errors.Any()) return;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var member = await db.Members
                .Include(m => m.MemberPositions)
                .FirstOrDefaultAsync(m => m.Id == Id);

            if (member == null) return;

            // Check username uniqueness if changed
            if (member.Username != _model.Username)
            {
                if (await db.Members.AnyAsync(m => m.Username == _model.Username))
                {
                    _errors.Add("Username is already taken.");
                    return;
                }
            }

            member.Username = _model.Username;
            member.FirstName = _model.FirstName;
            member.MiddleName = _model.MiddleName;
            member.LastName = _model.LastName;
            member.ContactNumber = _model.ContactNumber;
            member.BirthDate = _model.BirthDate;
            member.Status = _model.Status;
            member.UpdatedAt = DateTime.UtcNow;

            if (!string.IsNullOrWhiteSpace(_model.Password))
            {
                member.Password = BCrypt.Net.BCrypt.HashPassword(_model.Password);
            }

            // Handle positions
            var currentPosIds = member.MemberPositions.Where(mp => mp.IsCurrent).Select(mp => mp.PositionId).ToList();
            var newPosIds = _model.SelectedPositionIds;

            var addedPosIds = newPosIds.Except(currentPosIds).ToList();
            var removedPosIds = currentPosIds.Except(newPosIds).ToList();

            foreach (var rId in removedPosIds)
            {
                var mp = member.MemberPositions.FirstOrDefault(m => m.PositionId == rId && m.IsCurrent);
                if (mp != null)
                {
                    mp.IsCurrent = false;
                    mp.UpdatedAt = DateTime.UtcNow;
                }
            }

            foreach (var aId in addedPosIds)
            {
                db.MemberPositions.Add(new MemberPosition
                {
                    MemberId = member.Id,
                    PositionId = aId,
                    DateAssigned = DateOnly.FromDateTime(DateTime.Now),
                    IsCurrent = true,
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                });
            }

            await db.SaveChangesAsync();
            Nav.NavigateTo($"/members/{member.Id}?success=Member updated successfully.");
        }
        catch (Exception ex)
        {
            _errors.Add("An error occurred while updating the member: " + ex.Message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("initLucide"); } catch (Exception) { }
        }
    }

    public class MemberEditModel
    {
        public string Username { get; set; } = string.Empty;
        public string? Password { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string? MiddleName { get; set; }
        public string LastName { get; set; } = string.Empty;
        public string? ContactNumber { get; set; }
        public DateOnly? BirthDate { get; set; }
        public string Status { get; set; } = "Active";
        public List<long> SelectedPositionIds { get; set; } = new();
    }
}
