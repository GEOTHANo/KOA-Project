@page "/members/qrcodes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "members")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Member QR Codes - Knights of the Altar</PageTitle>

<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <a href="/members" class="text-gray-400 dark:text-slate-500 hover:text-gray-600 dark:hover:text-slate-200 transition-colors">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Member QR Codes</h1>
                <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Each QR is permanent and tied to the member ID. Use to scan attendance.</p>
            </div>
        </div>
        <button @onclick="PrintAll" class="bg-[#246b9c] hover:bg-[#1a547b] text-white text-xs font-bold px-4 py-2.5 rounded-xl flex items-center gap-2 transition-all shadow-sm">
            <i data-lucide="printer" class="w-4 h-4"></i> Print All QR Codes
        </button>
    </div>

    <div class="relative max-w-xs">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i data-lucide="search" class="w-4 h-4 text-gray-400 dark:text-slate-500"></i>
        </div>
        <input type="text" @bind="_searchQuery" @bind:event="oninput" @bind:after="FilterMembers"
               placeholder="Search member..."
               class="w-full pl-10 pr-4 py-2.5 border border-gray-200 dark:border-slate-700 dark:bg-slate-800 dark:text-white rounded-xl text-sm focus:ring-2 focus:ring-[#246b9c] outline-none" />
    </div>

    @if (_isLoading)
    {
        <div class="flex items-center justify-center py-16 text-gray-400 dark:text-slate-500">
            <i data-lucide="loader-2" class="w-6 h-6 animate-spin mr-2"></i> Loading members...
        </div>
    }
    else
    {
        <div id="qr-print-area" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-4">
            @foreach (var m in _filtered)
            {
                <div class="bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl p-4 flex flex-col items-center text-center shadow-sm hover:shadow-md transition-shadow">
                    <canvas id="qr-@m.Id" class="rounded-lg mb-3"></canvas>
                    <p class="text-xs font-bold text-gray-800 dark:text-white leading-snug">@m.LastName, @m.FirstName</p>
                    <p class="text-[10px] text-gray-400 dark:text-slate-500 mt-0.5">ID: @m.Id</p>
                    <button @onclick="@(() => DownloadQR(m.Id, m.FullName))"
                            class="mt-2 text-[10px] font-semibold text-[#246b9c] dark:text-blue-400 hover:underline flex items-center gap-1">
                        <i data-lucide="download" class="w-3 h-3"></i> Save PNG
                    </button>
                </div>
            }
        </div>
    }
</div>

<style>
    @@media print {
        body * { visibility: hidden; }
        #qr-print-area, #qr-print-area * { visibility: visible; }
        #qr-print-area { position: fixed; top: 0; left: 0; width: 100%; }
    }
</style>

@code {
    private List<Member> _members = new();
    private List<Member> _filtered = new();
    private string _searchQuery = string.Empty;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        _members = await db.Members
            .Where(m => m.Status == "Active")
            .OrderBy(m => m.LastName).ThenBy(m => m.FirstName)
            .ToListAsync();
        _filtered = _members.ToList();
        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("initLucide"); } catch { }
            await RenderQRCodes();
        }
    }

    private void FilterMembers()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
            _filtered = _members.ToList();
        else
        {
            var q = _searchQuery.ToLower();
            _filtered = _members.Where(m =>
                m.FirstName.ToLower().Contains(q) ||
                m.LastName.ToLower().Contains(q)).ToList();
        }
        _ = Task.Delay(80).ContinueWith(_ => InvokeAsync(RenderQRCodes));
    }

    private async Task RenderQRCodes()
    {
        foreach (var m in _filtered)
        {
            try { await JS.InvokeVoidAsync("renderMemberQR", $"qr-{m.Id}", $"KOA-MEMBER-{m.Id}"); }
            catch { }
        }
        try { await JS.InvokeVoidAsync("initLucide"); } catch { }
    }

    private async Task DownloadQR(long memberId, string fullName)
    {
        try { await JS.InvokeVoidAsync("downloadMemberQR", $"qr-{memberId}", fullName.Replace(" ", "_")); }
        catch { }
    }

    private async Task PrintAll() => await JS.InvokeVoidAsync("eval", "window.print()");
}