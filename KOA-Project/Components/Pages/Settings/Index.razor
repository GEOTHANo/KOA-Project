@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Settings - Knights of the Altar</PageTitle>

<div class="space-y-6 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Account Settings</h1>
            <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Manage your credentials, security, and member QR code.</p>
        </div>
        <a href="/members/qrcodes" class="bg-[#246b9c] hover:bg-[#1a547b] text-white text-xs font-bold px-4 py-2.5 rounded-xl inline-flex items-center gap-2 transition-all shadow-sm self-start sm:self-auto">
            <i data-lucide="qr-code" class="w-4 h-4"></i> View All Member QRs
        </a>
    </div>

    @if (_member == null)
    {
        <div class="flex items-center justify-center py-12 text-gray-400 dark:text-slate-500">
            <i data-lucide="loader-2" class="w-6 h-6 animate-spin mr-2"></i> Loading settings...
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(QueryError))
        {
            <div class="bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300 p-4 rounded-xl text-sm flex items-center gap-2 shadow-sm">
                <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i> <span>@QueryError</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(QuerySuccess))
        {
            <div class="bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 px-4 py-3 rounded-xl text-sm font-semibold flex items-center gap-2 shadow-sm">
                <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i> <span>@QuerySuccess</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 px-4 py-3 rounded-xl text-sm font-semibold flex items-center gap-2 shadow-sm">
                <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i> <span>@_successMessage</span>
            </div>
        }

        @if (_errors.Any())
        {
            <div class="bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300 p-4 rounded-xl text-sm space-y-1 shadow-sm">
                @foreach (var err in _errors)
                {
                    <div class="flex items-center gap-2"><i data-lucide="x-circle" class="w-4 h-4 shrink-0"></i> <span>@err</span></div>
                }
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column: Security Settings -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Credentials Section -->
                <div class="bg-white dark:bg-slate-900 border border-gray-100 dark:border-slate-800/80 rounded-2xl p-6 shadow-sm space-y-5">
                    <div class="border-b border-gray-100 dark:border-slate-800 pb-4">
                        <h2 class="text-base font-bold text-gray-800 dark:text-white flex items-center gap-2">
                            <i data-lucide="user-check" class="w-4 h-4 text-[#246b9c]"></i> Credentials & Profile Information
                        </h2>
                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5">Update your login username and account details.</p>
                    </div>

                    <form @onsubmit="HandleSubmit" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 dark:text-slate-300 mb-1">Username</label>
                            <input type="text" @bind="_model.Username" required
                                   class="w-full bg-gray-50 dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/80 rounded-xl px-3.5 py-2.5 text-sm text-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#246b9c]/30 focus:border-[#246b9c]" />
                        </div>

                        <div class="border-t border-gray-100 dark:border-slate-800 pt-4 mt-6">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-3">Change Password</h3>
                            
                            <div class="space-y-3">
                                <div>
                                    <label class="block text-xs font-semibold text-gray-700 dark:text-slate-300 mb-1">Current Password</label>
                                    <input type="password" @bind="_model.CurrentPassword" placeholder="Required only if changing password"
                                           class="w-full bg-gray-50 dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/80 rounded-xl px-3.5 py-2.5 text-sm text-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#246b9c]/30 focus:border-[#246b9c]" />
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-gray-700 dark:text-slate-300 mb-1">New Password</label>
                                    <input type="password" @bind="_model.NewPassword" placeholder="Leave empty to keep current password"
                                           class="w-full bg-gray-50 dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/80 rounded-xl px-3.5 py-2.5 text-sm text-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#246b9c]/30 focus:border-[#246b9c]" />
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-gray-700 dark:text-slate-300 mb-1">Confirm New Password</label>
                                    <input type="password" @bind="_model.NewPasswordConfirmation" placeholder="Re-enter new password"
                                           class="w-full bg-gray-50 dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/80 rounded-xl px-3.5 py-2.5 text-sm text-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#246b9c]/30 focus:border-[#246b9c]" />
                                </div>
                            </div>
                        </div>

                        <div class="pt-2 flex justify-end">
                            <button type="submit" class="bg-[#246b9c] hover:bg-[#1a547b] text-white font-semibold px-6 py-2.5 rounded-xl text-sm transition-colors shadow-sm">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Right Column: Member Profile & QR -->
            <div class="space-y-6">
                <!-- Profile & QR Card -->
                <div class="bg-white dark:bg-slate-900 border border-gray-100 dark:border-slate-800/80 rounded-2xl p-6 shadow-sm space-y-6">
                    <div class="text-center">
                        <div class="w-20 h-20 rounded-full bg-[#246b9c]/10 text-[#246b9c] font-bold text-2xl flex items-center justify-center mx-auto mb-3">
                            @_member.Initials
                        </div>
                        <h3 class="font-bold text-gray-800 dark:text-white text-base">@_member.FullName</h3>
                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5">@@@_member.Username</p>
                    </div>

                    <div class="border-t border-gray-100 dark:border-slate-800 pt-5 text-center">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-3">My Attendance QR Code</h4>
                        <div class="p-3 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-2xl mb-3 flex items-center justify-center inline-block">
                            <canvas id="qr-my-code" class="rounded-lg shadow-sm"></canvas>
                        </div>
                        <div class="mt-4">
                            <button type="button" @onclick="DownloadMyQR"
                                    class="bg-[#246b9c] hover:bg-[#1a547b] text-white text-xs font-semibold px-4 py-2 rounded-xl inline-flex items-center gap-1.5 transition-colors shadow-sm">
                                <i data-lucide="download" class="w-3.5 h-3.5"></i> Download QR PNG
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "success")]
    public string? QuerySuccess { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? QueryError { get; set; }

    private Member? _member;
    private SettingsModel _model = new();
    private string? _successMessage;
    private List<string> _errors = new();
    
    private long _currentUserId;
    private bool _qrRendered = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var nameIdentifier = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (long.TryParse(nameIdentifier, out var id))
        {
            _currentUserId = id;
            using var db = await DbFactory.CreateDbContextAsync();
            _member = await db.Members
                .Include(m => m.MemberPositions)
                    .ThenInclude(mp => mp.Position)
                .FirstOrDefaultAsync(m => m.Id == id);
                
            if (_member != null)
            {
                _model.Username = _member.Username;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("initLucide"); } catch { }

        if (_member != null && !_qrRendered)
        {
            _qrRendered = true;
            try
            {
                await JS.InvokeVoidAsync("renderMemberQR", "qr-my-code", $"KOA-MEMBER-{_member.Id}");
            }
            catch (Exception ex)
            {
                Console.WriteLine("QR Render Exception: " + ex.Message);
            }
        }
    }

    private async Task DownloadMyQR()
    {
        if (_member != null)
        {
            try { await JS.InvokeVoidAsync("downloadMemberQR", "qr-my-code", _member.FullName.Replace(" ", "_")); }
            catch { }
        }
    }

    private async Task HandleSubmit()
    {
        _errors.Clear();
        _successMessage = null;
        
        if (string.IsNullOrWhiteSpace(_model.Username)) _errors.Add("Username is required.");

        if (!string.IsNullOrEmpty(_model.NewPassword) || !string.IsNullOrEmpty(_model.CurrentPassword))
        {
            if (string.IsNullOrEmpty(_model.CurrentPassword)) _errors.Add("Current password is required to change password.");
            if (string.IsNullOrEmpty(_model.NewPassword)) _errors.Add("New password is required.");
            if (_model.NewPassword != _model.NewPasswordConfirmation) _errors.Add("New passwords do not match.");
        }
        
        if (_errors.Any()) return;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var member = await db.Members.FindAsync(_currentUserId);
            if (member == null) return;

            // Update Username
            if (member.Username != _model.Username)
            {
                if (await db.Members.AnyAsync(m => m.Username == _model.Username && m.Id != _currentUserId))
                {
                    _errors.Add("Username is already taken.");
                    return;
                }
                member.Username = _model.Username;
            }

            // Update Password
            if (!string.IsNullOrEmpty(_model.NewPassword))
            {
                if (!BCrypt.Net.BCrypt.Verify(_model.CurrentPassword, member.Password))
                {
                    _errors.Add("Current password is incorrect.");
                    return;
                }
                member.Password = BCrypt.Net.BCrypt.HashPassword(_model.NewPassword);
            }

            member.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
            
            _successMessage = "Settings updated successfully.";
            
            // Clear passwords
            _model.CurrentPassword = string.Empty;
            _model.NewPassword = string.Empty;
            _model.NewPasswordConfirmation = string.Empty;
            
            // Update _member reference for view
            _member = await db.Members
                .Include(m => m.MemberPositions)
                    .ThenInclude(mp => mp.Position)
                .FirstOrDefaultAsync(m => m.Id == _currentUserId);

            _qrRendered = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _errors.Add("An error occurred: " + ex.Message);
        }
    }

    public class SettingsModel
    {
        public string Username { get; set; } = string.Empty;
        public string? CurrentPassword { get; set; }
        public string? NewPassword { get; set; }
        public string? NewPasswordConfirmation { get; set; }
    }
}
