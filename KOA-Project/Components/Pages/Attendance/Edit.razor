@page "/attendance/edit/{DateStr}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "attendance")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims

<PageTitle>Edit Attendance - Knights of the Altar</PageTitle>

<div class="space-y-6 max-w-5xl mx-auto">
    <div class="flex items-center">
        <a href="/attendance" class="text-gray-400 dark:text-slate-500 hover:text-gray-600 dark:hover:text-slate-200 mr-3 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Edit Attendance</h1>
            <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Modify attendance records for @_targetDate.ToString("MMMM dd, yyyy")</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">@_errorMessage</div>
    }

    <!-- Date Card -->
    <div class="bg-amber-600 rounded-xl text-white p-6 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-white/80 text-sm font-semibold uppercase tracking-wider mb-1">Editing Date</p>
            <h2 class="text-3xl font-bold">@_targetDate.ToString("dddd, MMMM dd, yyyy")</h2>
        </div>
        <div class="bg-white/10 p-4 rounded-xl hidden sm:block">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        </div>
    </div>

    <!-- Attendance List -->
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
            <h3 class="text-sm font-semibold text-gray-700">Members List (@_memberAttendances.Count)</h3>
        </div>
        
        <div class="divide-y divide-gray-100">
            @foreach (var item in _memberAttendances)
            {
                var localItem = item;
                <div class="p-4 sm:px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-gray-50/50 transition-colors">
                    <div class="flex items-center gap-4">
                        <div class="bg-[#246b9c] text-white font-bold rounded-full w-10 h-10 flex items-center justify-center shrink-0 text-sm">
                            @localItem.Member.Initials
                        </div>
                        <div>
                            <h4 class="font-semibold text-gray-900">@localItem.Member.LastName, @localItem.Member.FirstName</h4>
                            <p class="text-xs text-gray-500 mt-0.5">@localItem.Role</p>
                        </div>
                    </div>
                    
                    <!-- 3 Buttons - Pure Blazor, no CSS peer tricks or radio inputs -->
                    <div class="flex items-center gap-2 shrink-0">
                        <button type="button"
                            class="@(localItem.Status == "Present" ? "bg-green-500 text-white" : "bg-gray-100 text-gray-500 hover:bg-gray-200") px-4 py-2 rounded-lg text-sm font-semibold transition-colors"
                            @onclick="@(() => { localItem.Status = "Present"; StateHasChanged(); })">
                            Present
                        </button>
                        <button type="button"
                            class="@(localItem.Status == "Excused" ? "bg-yellow-500 text-white" : "bg-gray-100 text-gray-500 hover:bg-gray-200") px-4 py-2 rounded-lg text-sm font-semibold transition-colors"
                            @onclick="@(() => { localItem.Status = "Excused"; StateHasChanged(); })">
                            Excused
                        </button>
                        <button type="button"
                            class="@(localItem.Status == "Absent" ? "bg-red-500 text-white" : "bg-gray-100 text-gray-500 hover:bg-gray-200") px-4 py-2 rounded-lg text-sm font-semibold transition-colors"
                            @onclick="@(() => { localItem.Status = "Absent"; StateHasChanged(); })">
                            Absent
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="px-6 py-5 bg-gray-50/50 border-t border-gray-100 flex items-center justify-end space-x-3">
            <a href="/attendance" class="px-6 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">Cancel</a>
            <button type="button" disabled="@_isSubmitting" @onclick="HandleSubmit" class="px-6 py-2.5 text-sm font-semibold text-white bg-amber-500 hover:bg-amber-600 rounded-lg transition-colors shadow-sm disabled:opacity-50 flex items-center gap-2">
                @if (_isSubmitting)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line></svg>
                    <span>Saving...</span>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                    <span>Update Attendance</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string DateStr { get; set; } = string.Empty;

    private DateOnly _targetDate;
    private string? _errorMessage;
    private bool _isSubmitting = false;
    private long _currentUserId;
    
    public class MemberAttendanceModel
    {
        public Member Member { get; set; } = null!;
        public string Role { get; set; } = string.Empty;
        public string Status { get; set; } = "Absent";
    }
    
    private List<MemberAttendanceModel> _memberAttendances = new();

    protected override async Task OnInitializedAsync()
    {
        if (DateOnly.TryParse(DateStr, out var d))
        {
            _targetDate = d;
        }
        else
        {
            Nav.NavigateTo("/attendance");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (long.TryParse(userIdStr, out var uid)) _currentUserId = uid;

        using var db = await DbFactory.CreateDbContextAsync();
        
        var members = await db.Members
            .Include(m => m.MemberPositions.Where(mp => mp.IsCurrent))
            .ThenInclude(mp => mp.Position)
            .Where(m => m.Status == "Active")
            .OrderBy(m => m.LastName)
            .ThenBy(m => m.FirstName)
            .ToListAsync();
            
        var existingRecords = await db.Attendances
            .Where(a => a.AttendanceDate == _targetDate)
            .ToDictionaryAsync(a => a.MemberId, a => a.Status);

        foreach (var m in members)
        {
            var role = m.MemberPositions.FirstOrDefault()?.Position?.PositionName ?? "Member";
            if (role != "Member") continue;
            
            _memberAttendances.Add(new MemberAttendanceModel
            {
                Member = m,
                Role = role,
                Status = existingRecords.TryGetValue(m.Id, out var existingStatus) ? existingStatus : "Absent"
            });
        }
    }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            
            var existing = await db.Attendances.Where(a => a.AttendanceDate == _targetDate).ToListAsync();
            db.Attendances.RemoveRange(existing);
            
            var weekStart = _targetDate;
            var weekEnd = _targetDate.AddDays(6);
            
            foreach (var item in _memberAttendances)
            {
                db.Attendances.Add(new AttendanceRecord
                {
                    MemberId = item.Member.Id,
                    MeetingWeekStart = weekStart,
                    MeetingWeekEnd = weekEnd,
                    AttendanceDate = _targetDate,
                    Status = item.Status,
                    RecordedBy = _currentUserId,
                    DateRecorded = DateTime.UtcNow,
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                });
            }
            
            await db.SaveChangesAsync();
            Nav.NavigateTo($"/attendance/view/{_targetDate.ToString("yyyy-MM-dd")}?success=Attendance updated successfully");
        }
        catch (Exception ex)
        {
            _errorMessage = "Error saving attendance: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }
}

