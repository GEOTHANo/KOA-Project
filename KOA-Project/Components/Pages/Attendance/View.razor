@page "/attendance/view/{DateStr}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "attendance")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>View Attendance - Knights of the Altar</PageTitle>

<div class="space-y-6 max-w-5xl mx-auto">
    <div class="flex items-center justify-between">
        <div class="flex items-center">
            <a href="/attendance" class="text-gray-400 dark:text-slate-500 hover:text-gray-600 dark:hover:text-slate-200 mr-3 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-gray-800 dark:text-white">View Attendance</h1>
                <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Review attendance for @_targetDate.ToString("MMMM dd, yyyy")</p>
            </div>
        </div>
        <div class="flex items-center space-x-2">
            <button onclick="exportToPdf('@DateStr')" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-lg text-sm shadow-sm transition-colors flex items-center gap-2">
                <!-- File text icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                Export PDF
            </button>
            <a href="/attendance/edit/@DateStr" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white font-semibold rounded-lg text-sm shadow-sm transition-colors flex items-center gap-2">
                <!-- Edit icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                Edit
            </a>
        </div>
    </div>

    <!-- UI View (what the user sees normally) -->
    <div id="ui-content" class="space-y-6">
        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white rounded-xl border border-gray-100 p-4 shadow-sm flex items-center justify-between">
                <span class="text-gray-500 text-sm font-semibold uppercase">Present</span>
                <span class="text-2xl font-bold text-green-600">@_records.Count(r => r.Status == "Present")</span>
            </div>
            <div class="bg-white rounded-xl border border-gray-100 p-4 shadow-sm flex items-center justify-between">
                <span class="text-gray-500 text-sm font-semibold uppercase">Excused</span>
                <span class="text-2xl font-bold text-yellow-600">@_records.Count(r => r.Status == "Excused")</span>
            </div>
            <div class="bg-white rounded-xl border border-gray-100 p-4 shadow-sm flex items-center justify-between">
                <span class="text-gray-500 text-sm font-semibold uppercase">Absent</span>
                <span class="text-2xl font-bold text-red-500">@_records.Count(r => r.Status == "Absent")</span>
            </div>
        </div>

        <!-- Attendance List -->
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
                <h3 class="text-sm font-semibold text-gray-700">Members List</h3>
            </div>
            
            <div class="divide-y divide-gray-100">
                @foreach (var item in _records.OrderBy(r => r.Member.LastName))
                {
                    <div class="p-4 sm:px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-gray-50/50 transition-colors">
                        <div class="flex items-center gap-4">
                            <div class="bg-[#246b9c] text-white font-bold rounded-full w-10 h-10 flex items-center justify-center shrink-0 text-sm">
                                @item.Member.Initials
                            </div>
                            <div>
                                <h4 class="font-semibold text-gray-900">@item.Member.LastName, @item.Member.FirstName</h4>
                            </div>
                        </div>
                        
                        <div class="shrink-0">
                            @if (item.Status == "Present")
                            {
                                <span class="inline-flex items-center gap-1 bg-green-100 text-green-800 text-sm font-semibold px-3 py-1 rounded-full">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                    Present
                                </span>
                            }
                            else if (item.Status == "Excused")
                            {
                                <span class="inline-flex items-center gap-1 bg-yellow-100 text-yellow-800 text-sm font-semibold px-3 py-1 rounded-full">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                    Excused
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 bg-red-100 text-red-800 text-sm font-semibold px-3 py-1 rounded-full">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                    Absent
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div> <!-- End ui-content -->

    <!-- PDF Export View (hidden by default) -->
    <div id="pdf-export-content" style="display: none; font-family: 'Helvetica Neue', Arial, sans-serif; padding: 30px; color: #1f2937; max-width: 720px; margin: 0 auto; background: white;">
        
        <!-- Header -->
        <div style="text-align:center; margin-bottom:20px; border-bottom:2px solid #246b9c; padding-bottom:16px;">
            <h1 style="margin:0 0 4px; font-size:20px; font-weight:800; color:#0d2233; letter-spacing:-0.02em;">
                Knights of the Altar
            </h1>
            <p style="margin:0; font-size:13px; color:#4b5563; font-weight:500;">Sto. Rosario Toril</p>
            <p style="margin:8px 0 0; font-size:13px; color:#374151;">
                <strong>Attendance Report</strong> &mdash; @_targetDate.ToString("MMMM dd, yyyy")
            </p>
        </div>

        <!-- Summary Cards -->
        <div style="display:flex; gap:12px; margin-bottom:20px;">
            <div style="flex:1; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; padding:12px 10px; text-align:center;">
                <div style="font-size:10px; font-weight:700; color:#15803d; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:4px;">Present</div>
                <div style="font-size:26px; font-weight:800; color:#16a34a;">@_records.Count(r => r.Status == "Present")</div>
            </div>
            <div style="flex:1; background:#fefce8; border:1px solid #fde68a; border-radius:8px; padding:12px 10px; text-align:center;">
                <div style="font-size:10px; font-weight:700; color:#a16207; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:4px;">Excused</div>
                <div style="font-size:26px; font-weight:800; color:#ca8a04;">@_records.Count(r => r.Status == "Excused")</div>
            </div>
            <div style="flex:1; background:#fef2f2; border:1px solid #fecaca; border-radius:8px; padding:12px 10px; text-align:center;">
                <div style="font-size:10px; font-weight:700; color:#991b1b; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:4px;">Absent</div>
                <div style="font-size:26px; font-weight:800; color:#dc2626;">@_records.Count(r => r.Status == "Absent")</div>
            </div>
        </div>

        <!-- Attendance Table -->
        <table style="width:100%; border-collapse:collapse; font-size:13px; border:1px solid #e5e7eb; border-radius:8px; overflow:hidden;">
            <thead>
                <tr style="background:#1e3a5f;">
                    <th style="padding:11px 12px; text-align:left; color:#ffffff; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; width:52%;">Member Name</th>
                    <th style="padding:11px 12px; text-align:center; color:#86efac; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; width:16%;">Present</th>
                    <th style="padding:11px 12px; text-align:center; color:#fde68a; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; width:16%;">Excused</th>
                    <th style="padding:11px 12px; text-align:center; color:#fca5a5; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; width:16%;">Absent</th>
                </tr>
            </thead>
            <tbody>
                @{
                    bool isEven = false;
                    foreach (var item in _records.OrderBy(r => r.Member.LastName))
                    {
                        var bg = isEven ? "#f9fafb" : "#ffffff";
                        isEven = !isEven;
                        <tr style="background:@bg;">
                            <td style="padding:9px 12px; font-size:12px; color:#111827; font-weight:500; border-bottom:1px solid #e5e7eb;">@item.Member.LastName, @item.Member.FirstName</td>
                            <td style="padding:9px 12px; text-align:center; font-size:16px; border-bottom:1px solid #e5e7eb;">
                                @if(item.Status == "Present") { <span style="color:#16a34a; font-weight:700;">&#10003;</span> }
                            </td>
                            <td style="padding:9px 12px; text-align:center; font-size:16px; border-bottom:1px solid #e5e7eb;">
                                @if(item.Status == "Excused") { <span style="color:#ca8a04; font-weight:700;">&#10003;</span> }
                            </td>
                            <td style="padding:9px 12px; text-align:center; font-size:16px; border-bottom:1px solid #e5e7eb;">
                                @if(item.Status == "Absent") { <span style="color:#dc2626; font-weight:700;">&#10003;</span> }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <!-- Timestamp Footer -->
        <div style="margin-top:18px; text-align:right; font-size:10px; color:#9ca3af;">
            Generated on: <strong style="color:#6b7280;">@DateTime.Now.ToString("MMMM dd, yyyy 'at' hh:mm tt")</strong>
        </div>
        <div style="margin-top:4px; text-align:right; font-size:10px; color:#d1d5db; text-transform:uppercase; letter-spacing:0.06em;">
            Knights of the Altar &mdash; Attendance System
        </div>
    </div> <!-- End pdf-export-content -->

</div>

@code {
    [Parameter]
    public string DateStr { get; set; } = string.Empty;

    private DateOnly _targetDate;
    private List<AttendanceRecord> _records = new();

    protected override async Task OnInitializedAsync()
    {
        if (DateOnly.TryParse(DateStr, out var d))
        {
            _targetDate = d;
        }
        else
        {
            Nav.NavigateTo("/attendance");
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var allRecords = await db.Attendances
            .Include(a => a.Member)
                .ThenInclude(m => m.MemberPositions.Where(mp => mp.IsCurrent))
                .ThenInclude(mp => mp.Position)
            .Where(a => a.AttendanceDate == _targetDate)
            .ToListAsync();
            
        _records = allRecords.Where(a => 
            (a.Member.MemberPositions.FirstOrDefault()?.Position?.PositionName ?? "Member") == "Member"
        ).ToList();
            
        if (!_records.Any())
        {
            Nav.NavigateTo("/attendance");
        }
    }
}

