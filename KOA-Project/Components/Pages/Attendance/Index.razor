@page "/attendance"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "attendance")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Attendance - Knights of the Altar</PageTitle>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Attendance</h1>
            <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Track and manage member attendance weekly.</p>
        </div>
        <a href="/attendance/check" class="bg-[#246b9c] hover:bg-[#1a547b] text-white text-sm font-semibold px-4 py-2.5 rounded-xl flex items-center justify-center transition-colors shadow-sm self-start sm:self-auto">
            <i data-lucide="clipboard-check" class="w-4 h-4 mr-2"></i> Check Attendance
        </a>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 px-4 py-3 rounded-xl text-sm font-semibold flex items-center gap-2">
            <i data-lucide="check-circle-2" class="w-4 h-4"></i> @_successMessage
        </div>
    }

    <!-- Stats Cards (Latest Record) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Present (Latest)</p>
                    <p class="text-2xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">@_totalPresent</p>
                </div>
                <div class="bg-emerald-50 dark:bg-emerald-950/60 p-3 rounded-xl"><i data-lucide="check-circle" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i></div>
            </div>
            @if(_latestDate.HasValue) { <div class="absolute bottom-0 left-0 w-full bg-emerald-50/50 dark:bg-emerald-950/40 px-5 py-1 text-[10px] text-emerald-600 dark:text-emerald-300 font-semibold border-t border-emerald-100/50 dark:border-emerald-900/30">@_latestDate.Value.ToString("MMM dd, yyyy")</div> }
        </div>
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Absent (Latest)</p>
                    <p class="text-2xl font-bold text-red-500 dark:text-red-400 mt-1">@_totalAbsent</p>
                </div>
                <div class="bg-red-50 dark:bg-red-950/60 p-3 rounded-xl"><i data-lucide="x-circle" class="w-5 h-5 text-red-500 dark:text-red-400"></i></div>
            </div>
            @if(_latestDate.HasValue) { <div class="absolute bottom-0 left-0 w-full bg-red-50/50 dark:bg-red-950/40 px-5 py-1 text-[10px] text-red-500 dark:text-red-300 font-semibold border-t border-red-100/50 dark:border-red-900/30">@_latestDate.Value.ToString("MMM dd, yyyy")</div> }
        </div>
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Excused (Latest)</p>
                    <p class="text-2xl font-bold text-amber-500 dark:text-amber-400 mt-1">@_totalExcused</p>
                </div>
                <div class="bg-amber-50 dark:bg-amber-950/60 p-3 rounded-xl"><i data-lucide="alert-circle" class="w-5 h-5 text-amber-500 dark:text-amber-400"></i></div>
            </div>
            @if(_latestDate.HasValue) { <div class="absolute bottom-0 left-0 w-full bg-amber-50/50 dark:bg-amber-950/40 px-5 py-1 text-[10px] text-amber-600 dark:text-amber-300 font-semibold border-t border-amber-100/50 dark:border-amber-900/30">@_latestDate.Value.ToString("MMM dd, yyyy")</div> }
        </div>
    </div>

    <!-- Submitted Attendances List -->
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 dark:border-slate-700 flex justify-between items-center">
            <h3 class="text-sm font-semibold text-gray-700 dark:text-slate-200">Submitted Attendances</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 dark:bg-slate-900 border-b border-gray-100 dark:border-slate-700">
                    <tr class="text-left text-gray-500 dark:text-slate-400 font-medium">
                        <th class="px-6 py-3 font-medium">Date</th>
                        <th class="px-6 py-3 font-medium text-center">Present</th>
                        <th class="px-6 py-3 font-medium text-center">Excused</th>
                        <th class="px-6 py-3 font-medium text-center">Absent</th>
                        <th class="px-6 py-3 font-medium text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_attendanceDates.Any())
                    {
                        <tr><td colspan="5" class="px-6 py-12 text-center text-gray-400 dark:text-slate-500">No attendance records found.</td></tr>
                    }
                    @foreach (var dateGroup in _attendanceDates)
                    {
                        <tr class="border-b border-gray-100 dark:border-slate-700/60 hover:bg-gray-50/50 dark:hover:bg-slate-700/50 transition-colors">
                            <td class="px-6 py-3 font-medium text-gray-800 dark:text-white">
                                @dateGroup.Date.ToString("dddd, MMMM dd, yyyy")
                            </td>
                            <td class="px-6 py-3 text-center">
                                <span class="inline-flex items-center justify-center bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 w-8 h-8 rounded-full text-xs font-bold">@dateGroup.PresentCount</span>
                            </td>
                            <td class="px-6 py-3 text-center">
                                <span class="inline-flex items-center justify-center bg-amber-50 dark:bg-amber-950/80 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800 w-8 h-8 rounded-full text-xs font-bold">@dateGroup.ExcusedCount</span>
                            </td>
                            <td class="px-6 py-3 text-center">
                                <span class="inline-flex items-center justify-center bg-red-50 dark:bg-red-950/80 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800 w-8 h-8 rounded-full text-xs font-bold">@dateGroup.AbsentCount</span>
                            </td>
                            <td class="px-6 py-3 text-right">
                                <div class="flex items-center justify-end space-x-2">
                                    <a href="/attendance/view/@dateGroup.Date.ToString("yyyy-MM-dd")" class="p-1.5 text-gray-400 dark:text-slate-400 hover:text-[#246b9c] dark:hover:text-blue-400 hover:bg-[#246b9c]/10 rounded-lg transition-colors" title="View">
                                        <i data-lucide="eye" class="w-4 h-4"></i>
                                    </a>
                                    <a href="/attendance/edit/@dateGroup.Date.ToString("yyyy-MM-dd")" class="p-1.5 text-gray-400 dark:text-slate-400 hover:text-amber-500 dark:hover:text-amber-400 hover:bg-amber-50 rounded-lg transition-colors" title="Edit">
                                        <i data-lucide="edit" class="w-4 h-4"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string? _successMessage;
    private int _totalPresent;
    private int _totalAbsent;
    private int _totalExcused;
    private DateOnly? _latestDate;
    
    public class AttendanceDateSummary
    {
        public DateOnly Date { get; set; }
        public int PresentCount { get; set; }
        public int AbsentCount { get; set; }
        public int ExcusedCount { get; set; }
    }
    
    private List<AttendanceDateSummary> _attendanceDates = new();

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("success", out var sm))
        {
            _successMessage = sm;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        
        _latestDate = await db.Attendances.MaxAsync(a => (DateOnly?)a.AttendanceDate);
        
        if (_latestDate.HasValue)
        {
            _totalPresent = await db.Attendances.CountAsync(a => a.AttendanceDate == _latestDate.Value && a.Status == "Present");
            _totalAbsent = await db.Attendances.CountAsync(a => a.AttendanceDate == _latestDate.Value && a.Status == "Absent");
            _totalExcused = await db.Attendances.CountAsync(a => a.AttendanceDate == _latestDate.Value && a.Status == "Excused");
        }

        var grouped = await db.Attendances
            .GroupBy(a => a.AttendanceDate)
            .Select(g => new AttendanceDateSummary
            {
                Date = g.Key,
                PresentCount = g.Count(x => x.Status == "Present"),
                AbsentCount = g.Count(x => x.Status == "Absent"),
                ExcusedCount = g.Count(x => x.Status == "Excused")
            })
            .OrderByDescending(x => x.Date)
            .ToListAsync();
            
        _attendanceDates = grouped;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("initLucide"); } catch (Exception) { }
        }
    }
}