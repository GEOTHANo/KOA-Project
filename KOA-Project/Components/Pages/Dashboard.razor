@page "/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Dashboard - Knights of the Altar</PageTitle>

<AuthorizeView>
    <Authorized>
        @{
            var user = context.User;
            bool canDashboard = AuthService.CanAccess(user, "dashboard");
            bool canMemberDashboard = AuthService.CanAccess(user, "member-dashboard");
        }

        @if (!canDashboard && canMemberDashboard)
        {
            <!-- Member Dashboard -->
            <div class="space-y-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Member Dashboard</h1>
                    <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Hello, @(user.FindFirst("FirstName")?.Value)! Here is your schedule and info for this month.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Sunday Schedule -->
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm p-6 flex flex-col min-h-[400px]">
                        <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-50">
                            <div class="flex items-center space-x-3">
                                <div class="bg-blue-50 p-2 rounded-lg text-[#246b9c]"><i data-lucide="calendar-days" class="w-5 h-5"></i></div>
                                <h3 class="font-bold text-gray-700 dark:text-slate-200">Sunday Schedule</h3>
                            </div>
                        </div>
                        <div class="flex-1 overflow-y-auto space-y-3 pr-1 max-h-[320px]">
                            @if (!_memberSundaySchedules.Any())
                            {
                                <div class="h-full flex flex-col items-center justify-center py-12 text-center">
                                    <i data-lucide="sparkles" class="w-8 h-8 text-gray-300 mb-2"></i>
                                    <p class="text-gray-400 text-sm">No upcoming Sunday masses assigned.</p>
                                </div>
                            }
                            @foreach (var s in _memberSundaySchedules)
                            {
                                <div @onclick="() => OpenMassDetailsModal(s.Schedule.Id, true)" class="p-3 bg-gray-50 dark:bg-slate-900 rounded-lg border border-gray-100 dark:border-slate-700 flex items-center justify-between border border-gray-100 cursor-pointer hover:bg-blue-50 transition-colors group">
                                    <div>
                                        <p class="font-semibold text-sm text-gray-800 dark:text-white group-hover:text-[#246b9c]">@s.Schedule.MassName</p>
                                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5">@s.Schedule.MassDate.ToString("MMM dd, yyyy") at @s.Schedule.MassTime.ToString("h:mm tt")</p>
                                    </div>
                                    <div class="flex flex-col items-end gap-1">
                                        @{ var statusClass = s.AttendanceStatus == "Present" ? "bg-green-100 text-green-800" : s.AttendanceStatus == "Absent" ? "bg-red-100 text-red-800" : "bg-yellow-100 text-yellow-800"; }
                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full @statusClass">@(s.AttendanceStatus ?? "Pending")</span>
                                        <span class="text-[10px] text-gray-400 group-hover:text-[#246b9c] flex items-center"><i data-lucide="users" class="w-3 h-3 mr-1"></i> View</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <!-- Weekday Schedule -->
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm p-6 flex flex-col min-h-[400px]">
                        <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-50">
                            <div class="flex items-center space-x-3">
                                <div class="bg-indigo-50 p-2 rounded-lg text-indigo-600"><i data-lucide="clock" class="w-5 h-5"></i></div>
                                <h3 class="font-bold text-gray-700 dark:text-slate-200">Weekdays</h3>
                            </div>
                        </div>
                        <div class="flex-1 overflow-y-auto space-y-3 pr-1 max-h-[320px]">
                            @if (!_memberWeekdaySchedules.Any())
                            {
                                <div class="h-full flex flex-col items-center justify-center py-12 text-center">
                                    <i data-lucide="coffee" class="w-8 h-8 text-gray-300 mb-2"></i>
                                    <p class="text-gray-400 text-sm">No weekday schedules assigned for this week.</p>
                                </div>
                            }
                            @foreach (var s in _memberWeekdaySchedules)
                            {
                                <div @onclick="() => OpenMassDetailsModal(s.Schedule.Id, false)" class="p-3 bg-gray-50 dark:bg-slate-900 rounded-lg border border-gray-100 dark:border-slate-700 flex items-center justify-between border border-gray-100 cursor-pointer hover:bg-indigo-50 transition-colors group">
                                    <div>
                                        <p class="font-semibold text-sm text-gray-800 dark:text-white group-hover:text-indigo-600">@s.Schedule.Day - @s.Schedule.MassType</p>
                                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5">@s.Schedule.MassTime.ToString("h:mm tt")</p>
                                    </div>
                                    <div class="flex flex-col items-end gap-1">
                                        @{ var sc = s.AttendanceStatus == "Present" ? "bg-green-100 text-green-800" : s.AttendanceStatus == "Absent" ? "bg-red-100 text-red-800" : "bg-yellow-100 text-yellow-800"; }
                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full @sc">@(s.AttendanceStatus ?? "Pending")</span>
                                        <span class="text-[10px] text-gray-400 group-hover:text-indigo-600 flex items-center"><i data-lucide="users" class="w-3 h-3 mr-1"></i> View</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <!-- Birthdays -->
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm p-6 flex flex-col min-h-[400px]">
                        <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-50">
                            <div class="flex items-center space-x-3">
                                <div class="bg-rose-50 dark:bg-rose-950/60 p-2 rounded-xl text-rose-600 dark:text-rose-400"><i data-lucide="cake" class="w-5 h-5"></i></div>
                                <h3 class="font-bold text-gray-700 dark:text-slate-200">Birthdays This Month</h3>
                            </div>
                        </div>
                        <div class="flex-1 overflow-y-auto space-y-3 pr-1 max-h-[320px]">
                            @if (!_birthdaysThisMonth.Any())
                            {
                                <div class="h-full flex flex-col items-center justify-center py-12 text-center">
                                    <i data-lucide="calendar-heart" class="w-8 h-8 text-gray-300 mb-2"></i>
                                    <p class="text-gray-400 text-sm">No member birthdays this month.</p>
                                </div>
                            }
                            @foreach (var m in _birthdaysThisMonth)
                            {
                                var daysLeft = m.BirthDate.HasValue ? m.BirthDate.Value.Day - DateTime.Now.Day : 0;
                                var badge = daysLeft == 0 ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800" : daysLeft > 0 ? "bg-blue-100 text-blue-800 dark:bg-blue-950/80 dark:text-blue-300 border border-blue-200 dark:border-blue-800" : "bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-600";
                                <div class="flex items-center justify-between p-2 hover:bg-gray-50 dark:hover:bg-slate-700/50 rounded-lg transition-colors">
                                    <div class="flex items-center">
                                        <div class="bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 font-bold rounded-full w-8 h-8 flex items-center justify-center mr-3 text-xs shrink-0">@m.Initials</div>
                                        <div>
                                            <p class="font-semibold text-sm text-gray-800 dark:text-white">@m.FirstName @m.LastName</p>
                                            <p class="text-xs text-gray-500 dark:text-slate-400">@(m.BirthDate?.ToString("MMM dd"))</p>
                                        </div>
                                    </div>
                                    <span class="text-xs font-semibold px-2 py-0.5 rounded-full @badge">@(daysLeft == 0 ? "Today!" : daysLeft > 0 ? $"In {daysLeft}d" : "Celebrated")</span>
                                </div>
                            }
                        </div>
                    </div>
                    <!-- Today's Mass Readings -->
                    <KOA_Project.Components.Shared.LiturgicalCard />
                </div>
            </div>
        }
        else if (canDashboard)
        {
            <!-- Admin Dashboard -->
            <div class="space-y-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Dashboard</h1>
                    <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Welcome back! Here's your personal schedule and the overall system overview.</p>
                </div>

                <!-- Personal Schedule Row -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Sunday Schedule -->
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm p-6 flex flex-col min-h-[350px]">
                        <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-50">
                            <div class="flex items-center space-x-3">
                                <div class="bg-blue-50 p-2 rounded-lg text-[#246b9c]"><i data-lucide="calendar-days" class="w-5 h-5"></i></div>
                                <h3 class="font-bold text-gray-700 dark:text-slate-200">My Sunday Schedule</h3>
                            </div>
                        </div>
                        <div class="flex-1 overflow-y-auto space-y-3 pr-1 max-h-[250px]">
                            @if (!_memberSundaySchedules.Any())
                            {
                                <div class="h-full flex flex-col items-center justify-center py-8 text-center">
                                    <i data-lucide="sparkles" class="w-8 h-8 text-gray-300 mb-2"></i>
                                    <p class="text-gray-400 text-sm">No upcoming Sunday masses assigned.</p>
                                </div>
                            }
                            @foreach (var s in _memberSundaySchedules)
                            {
                                <div @onclick="() => OpenMassDetailsModal(s.Schedule.Id, true)" class="p-3 bg-gray-50 dark:bg-slate-900 rounded-lg border border-gray-100 dark:border-slate-700 flex items-center justify-between border border-gray-100 cursor-pointer hover:bg-blue-50 transition-colors group">
                                    <div>
                                        <p class="font-semibold text-sm text-gray-800 dark:text-white group-hover:text-[#246b9c]">@s.Schedule.MassName</p>
                                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5">@s.Schedule.MassDate.ToString("MMM dd, yyyy") at @s.Schedule.MassTime.ToString("h:mm tt")</p>
                                    </div>
                                    <div class="flex flex-col items-end gap-1">
                                        @{ var statusClass = s.AttendanceStatus == "Present" ? "bg-green-100 text-green-800" : s.AttendanceStatus == "Absent" ? "bg-red-100 text-red-800" : "bg-yellow-100 text-yellow-800"; }
                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full @statusClass">@(s.AttendanceStatus ?? "Pending")</span>
                                        <span class="text-[10px] text-gray-400 group-hover:text-[#246b9c] flex items-center"><i data-lucide="users" class="w-3 h-3 mr-1"></i> View Servers</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <!-- Weekday Schedule -->
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm p-6 flex flex-col min-h-[350px]">
                        <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-50">
                            <div class="flex items-center space-x-3">
                                <div class="bg-indigo-50 p-2 rounded-lg text-indigo-600"><i data-lucide="clock" class="w-5 h-5"></i></div>
                                <h3 class="font-bold text-gray-700 dark:text-slate-200">My Weekdays</h3>
                            </div>
                        </div>
                        <div class="flex-1 overflow-y-auto space-y-3 pr-1 max-h-[250px]">
                            @if (!_memberWeekdaySchedules.Any())
                            {
                                <div class="h-full flex flex-col items-center justify-center py-8 text-center">
                                    <i data-lucide="coffee" class="w-8 h-8 text-gray-300 mb-2"></i>
                                    <p class="text-gray-400 text-sm">No weekday schedules assigned for this week.</p>
                                </div>
                            }
                            @foreach (var s in _memberWeekdaySchedules)
                            {
                                <div @onclick="() => OpenMassDetailsModal(s.Schedule.Id, false)" class="p-3 bg-gray-50 dark:bg-slate-900 rounded-lg border border-gray-100 dark:border-slate-700 flex items-center justify-between border border-gray-100 cursor-pointer hover:bg-indigo-50 transition-colors group">
                                    <div>
                                        <p class="font-semibold text-sm text-gray-800 dark:text-white group-hover:text-indigo-600">@s.Schedule.Day - @s.Schedule.MassType</p>
                                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5">@s.Schedule.MassTime.ToString("h:mm tt")</p>
                                    </div>
                                    <div class="flex flex-col items-end gap-1">
                                        @{ var sc = s.AttendanceStatus == "Present" ? "bg-green-100 text-green-800" : s.AttendanceStatus == "Absent" ? "bg-red-100 text-red-800" : "bg-yellow-100 text-yellow-800"; }
                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full @sc">@(s.AttendanceStatus ?? "Pending")</span>
                                        <span class="text-[10px] text-gray-400 group-hover:text-indigo-600 flex items-center"><i data-lucide="users" class="w-3 h-3 mr-1"></i> View Servers</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <!-- Today's Schedule -->
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm p-6 flex flex-col min-h-[350px]">
                        <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-50">
                            <div class="flex items-center space-x-3">
                                <div class="bg-teal-50 p-2 rounded-lg text-teal-600"><i data-lucide="sun" class="w-5 h-5"></i></div>
                                <h3 class="font-bold text-gray-700 dark:text-slate-200">Mass for Today</h3>
                            </div>
                        </div>
                        <div class="flex-1 overflow-y-auto space-y-3 pr-1 max-h-[250px]">
                            @if (!_todaySchedules.Any())
                            {
                                <div class="h-full flex flex-col items-center justify-center py-8 text-center">
                                    <i data-lucide="coffee" class="w-8 h-8 text-gray-300 mb-2"></i>
                                    <p class="text-gray-400 text-sm">No masses scheduled for today.</p>
                                </div>
                            }
                            @foreach (var s in _todaySchedules)
                            {
                                <div @onclick="() => OpenMassDetailsModal(s.Id, s.IsSunday)" class="p-3 bg-gray-50 dark:bg-slate-900 rounded-lg border border-gray-100 dark:border-slate-700 flex items-center justify-between border border-gray-100 cursor-pointer hover:bg-teal-50 transition-colors group">
                                    <div>
                                        <p class="font-semibold text-sm text-gray-800 dark:text-white group-hover:text-teal-600">@s.Name</p>
                                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5">@s.Time</p>
                                    </div>
                                    <div class="flex flex-col items-end gap-1">
                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-blue-50 text-[#246b9c]">@s.ServerCount Servers</span>
                                        <span class="text-[10px] text-gray-400 group-hover:text-teal-600 flex items-center"><i data-lucide="users" class="w-3 h-3 mr-1"></i> View</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Stat Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 p-5 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Total Members</p>
                                <p class="text-2xl font-bold text-gray-800 dark:text-white mt-1">@_totalMembers</p>
                            </div>
                            <div class="bg-blue-50 dark:bg-blue-950/60 p-3 rounded-xl"><i data-lucide="users" class="w-5 h-5 text-blue-600 dark:text-blue-400"></i></div>
                        </div>
                    </div>
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 p-5 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Present This Week</p>
                                <p class="text-2xl font-bold text-green-600 mt-1">@_presentThisWeek</p>
                            </div>
                            <div class="bg-emerald-50 dark:bg-emerald-950/60 p-3 rounded-xl"><i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i></div>
                        </div>
                    </div>
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 p-5 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Absent This Week</p>
                                <p class="text-2xl font-bold text-red-500 mt-1">@_absentThisWeek</p>
                            </div>
                            <div class="bg-red-50 dark:bg-red-950/60 p-3 rounded-xl"><i data-lucide="x-circle" class="w-5 h-5 text-red-500 dark:text-red-400"></i></div>
                        </div>
                    </div>
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 p-5 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Inactive Members</p>
                                <p class="text-2xl font-bold text-yellow-600 mt-1">@_inactiveMembers</p>
                            </div>
                            <div class="bg-amber-50 dark:bg-amber-950/60 p-3 rounded-xl"><i data-lucide="user-minus" class="w-5 h-5 text-amber-500 dark:text-amber-400"></i></div>
                        </div>
                    </div>
                </div>

                <!-- Charts Row -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 bg-white dark:bg-slate-900 rounded-2xl border border-gray-100 dark:border-slate-800 shadow-sm p-6">
                        <h3 class="text-sm font-semibold text-gray-700 dark:text-white mb-4">Monthly Attendance (Last 12 Months)</h3>
                        <div class="relative w-full h-64 max-h-64 overflow-hidden"><canvas id="monthlyChart"></canvas></div>
                    </div>
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm p-6">
                        <h3 class="text-sm font-semibold text-gray-700 dark:text-white mb-4">Member Status Distribution</h3>
                        <div class="relative w-full h-48 max-h-48 overflow-hidden flex items-center justify-center"><canvas id="statusChart"></canvas></div>
                        <div class="mt-4 space-y-2">
                            <div class="flex items-center justify-between text-sm text-gray-700 dark:text-slate-300">
                                <div class="flex items-center"><span class="w-3 h-3 bg-blue-500 rounded-full mr-2"></span>Active</div>
                                <span class="font-semibold dark:text-white">@_activePercent%</span>
                            </div>
                            <div class="flex items-center justify-between text-sm text-gray-700 dark:text-slate-300">
                                <div class="flex items-center"><span class="w-3 h-3 bg-yellow-500 rounded-full mr-2"></span>Inactive</div>
                                <span class="font-semibold dark:text-white">@_inactivePercent%</span>
                            </div>
                            <div class="flex items-center justify-between text-sm text-gray-700 dark:text-slate-300">
                                <div class="flex items-center"><span class="w-3 h-3 bg-gray-400 rounded-full mr-2"></span>Alumni</div>
                                <span class="font-semibold dark:text-white">@_alumniPercent%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Current Month Saturday Attendance -->
                <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm p-6">
                    <h3 class="text-sm font-semibold text-gray-700 dark:text-white mb-4">This Month's Attendance (@DateTime.Now.ToString("MMMM yyyy"))</h3>
                    <div class="relative w-full h-64 max-h-64 overflow-hidden"><canvas id="currentMonthChart"></canvas></div>
                </div>

                <!-- Bottom Row: Leaders & Birthdays -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 bg-white dark:bg-slate-900 rounded-2xl border border-gray-100 dark:border-slate-800 shadow-sm p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-sm font-semibold text-gray-700 dark:text-white">Leadership & Officers</h3>
                        </div>
                        @if (_leaders.Any())
                        {
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm">
                                    <thead>
                                        <tr class="text-left text-gray-500 dark:text-slate-400 border-b border-gray-100 dark:border-slate-700">
                                            <th class="pb-3 font-medium">Name</th>
                                            <th class="pb-3 font-medium">Position</th>
                                            <th class="pb-3 font-medium">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var leader in _leaders)
                                        {
                                            <tr class="border-b border-gray-100 dark:border-slate-700/60 hover:bg-gray-50/50 dark:hover:bg-slate-700/50 transition-colors">
                                                <td class="py-3">
                                                    <div class="flex items-center">
                                                        <div class="bg-[#246b9c] text-white font-bold rounded-full w-8 h-8 flex items-center justify-center mr-3 text-xs">@leader.Initials</div>
                                                        <span class="font-medium text-gray-800 dark:text-white">@leader.LastName, @leader.FirstName</span>
                                                    </div>
                                                </td>
                                                <td class="py-3">
                                                    @foreach (var pos in leader.MemberPositions.Where(mp => mp.IsCurrent))
                                                    {
                                                        <span class="inline-block bg-blue-50 dark:bg-blue-950/80 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800 text-xs px-2 py-0.5 rounded-md mr-1 font-medium">@pos.Position.PositionName</span>
                                                    }
                                                </td>
                                                <td class="py-3">
                                                    <span class="inline-block bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 text-xs px-2 py-0.5 rounded-full font-medium">@leader.Status</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-gray-400 text-sm text-center py-8">No leadership positions assigned yet.</p>
                        }
                    </div>
                    <!-- Birthdays -->
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm p-6 flex flex-col">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-sm font-semibold text-gray-700 dark:text-white">Birthdays This Month (@DateTime.Now.ToString("MMMM"))</h3>
                            <div class="bg-rose-50 dark:bg-rose-950/60 p-2 rounded-xl text-rose-600 dark:text-rose-400"><i data-lucide="cake" class="w-4 h-4"></i></div>
                        </div>
                        @if (_birthdaysThisMonth.Any())
                        {
                            <div class="overflow-y-auto max-h-[300px] space-y-3 flex-1 pr-1">
                                @foreach (var m in _birthdaysThisMonth)
                                {
                                    var daysLeft = m.BirthDate.HasValue ? m.BirthDate.Value.Day - DateTime.Now.Day : 0;
                                    var badge = daysLeft == 0 ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800" : daysLeft > 0 ? "bg-blue-100 text-blue-800 dark:bg-blue-950/80 dark:text-blue-300 border border-blue-200 dark:border-blue-800" : "bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-600";
                                    <div class="flex items-center justify-between p-2 hover:bg-gray-50 dark:hover:bg-slate-700/50 rounded-lg transition-colors">
                                        <div class="flex items-center">
                                            <div class="bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 font-bold rounded-full w-8 h-8 flex items-center justify-center mr-3 text-xs shrink-0">@m.Initials</div>
                                            <div>
                                                <p class="font-semibold text-sm text-gray-800 dark:text-white">@m.FirstName @m.LastName</p>
                                                <p class="text-xs text-gray-500 dark:text-slate-400">@(m.BirthDate?.ToString("MMM dd"))</p>
                                            </div>
                                        </div>
                                        <span class="text-xs font-semibold px-2 py-0.5 rounded-full @badge">@(daysLeft == 0 ? "Today!" : daysLeft > 0 ? $"In {daysLeft}d" : "Celebrated")</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="flex-1 flex flex-col items-center justify-center py-8">
                                <i data-lucide="calendar" class="w-8 h-8 text-gray-300 mb-2"></i>
                                <p class="text-gray-400 text-sm text-center">No birthdays this month.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Mass Readings Row -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-1">
                        <KOA_Project.Components.Shared.LiturgicalCard />
                    </div>
                    <div class="lg:col-span-2 bg-white dark:bg-slate-900 rounded-2xl border border-gray-100 dark:border-slate-800 shadow-sm p-6 flex flex-col items-center justify-center text-center">
                        <div class="bg-[#246b9c]/10 dark:bg-blue-950/60 p-4 rounded-full mb-3 text-[#246b9c] dark:text-blue-400">
                            <i data-lucide="book-open" class="w-8 h-8 text-[#246b9c] dark:text-blue-400"></i>
                        </div>
                        <h3 class="font-bold text-gray-700 dark:text-white mb-1">Daily Prayer Reminder</h3>
                        <p class="text-sm text-gray-600 dark:text-slate-300 max-w-sm leading-relaxed">&quot;Let the word of Christ dwell in you richly.&quot; - Col 3:16</p>
                        <p class="text-xs text-gray-400 dark:text-slate-400 mt-3">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            Nav.NavigateTo("/schedules");
        }
    </Authorized>
</AuthorizeView>

<!-- Mass Details Modal -->
@if (_isMassModalOpen)
{
    <div class="fixed inset-0 bg-gray-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 transition-all duration-300">
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden transform transition-all border border-gray-100 dark:border-slate-700">
            <div class="flex justify-between items-center px-6 py-4 border-b border-gray-100 dark:border-slate-700 bg-gray-50/50 dark:bg-slate-900/50">
                <div class="flex items-center gap-3">
                    <div class="bg-[#246b9c]/10 p-2 rounded-lg text-[#246b9c]">
                        <i data-lucide="users" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-gray-800 dark:text-white tracking-tight">Assigned Servers</h3>
                        <p class="text-[11px] text-gray-500 dark:text-slate-400 mt-0.5 leading-tight">@_modalMassTitle</p>
                    </div>
                </div>
                <button type="button" @onclick="CloseMassModal" class="text-gray-400 dark:text-slate-500 hover:text-gray-600 dark:hover:text-slate-200 bg-gray-100 hover:bg-gray-200 rounded-full p-2 transition-colors focus:outline-none">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
            
            <div class="p-6">
                @if (_isModalLoading)
                {
                    <div class="flex justify-center items-center py-8">
                        <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-[#246b9c]"></div>
                    </div>
                }
                else if (!_modalServers.Any())
                {
                    <div class="text-center py-8">
                        <p class="text-gray-500 text-sm">No servers assigned to this mass yet.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-2 max-h-[300px] overflow-y-auto pr-1">
                        @foreach (var server in _modalServers)
                        {
                            <div class="flex items-center p-3 bg-gray-50 rounded-xl border border-gray-100">
                                <div class="bg-blue-100 text-[#246b9c] font-bold rounded-full w-8 h-8 flex items-center justify-center mr-3 text-xs">
                                    @server.Initials
                                </div>
                                <div>
                                    <p class="font-bold text-sm text-gray-800">@server.FullName</p>
                                    <p class="text-[10px] text-gray-500">@server.PrimaryRole</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="px-6 py-4 border-t border-gray-100 bg-gray-50/80 flex justify-end">
                <button type="button" @onclick="CloseMassModal" class="px-5 py-2 text-sm font-bold text-gray-600 hover:text-gray-900 bg-white border border-gray-300 rounded-xl hover:bg-gray-50 transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-gray-200">Close</button>
            </div>
        </div>
    </div>
}

@code {
    // Admin stats
    private int _totalMembers, _activeMembers, _inactiveMembers, _alumniMembers;
    private int _activePercent, _inactivePercent, _alumniPercent;
    private int _presentThisWeek, _absentThisWeek;
    private List<Member> _leaders = new();
    private List<Member> _birthdaysThisMonth = new();
    private List<(string Label, int Count)> _monthlyData = new();
    
    // This month's Saturday attendance
    private List<string> _thisMonthSaturdays = new();
    private List<int> _thisMonthPresent = new();
    private List<int> _thisMonthAbsent = new();
    private List<int> _thisMonthExcused = new();

    // Member-specific
    private List<SundayScheduleMember> _memberSundaySchedules = new();
    private List<WeekdayScheduleMember> _memberWeekdaySchedules = new();

    private class TodayMassInfo
    {
        public long Id { get; set; }
        public bool IsSunday { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Time { get; set; } = string.Empty;
        public int ServerCount { get; set; }
        public TimeOnly TimeValue { get; set; }
    }
    private List<TodayMassInfo> _todaySchedules = new();

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var user = authState.User;
        if (!user.Identity?.IsAuthenticated ?? true) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var now = DateTime.Now;
        var today = DateOnly.FromDateTime(now);

        _birthdaysThisMonth = await db.Members
            .Where(m => m.BirthDate.HasValue && m.BirthDate.Value.Month == today.Month)
            .OrderBy(m => m.BirthDate!.Value.Day)
            .ToListAsync();

        var memberIdStr = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (long.TryParse(memberIdStr, out var memberId))
        {
            // Calculate start of the current week (Sunday)
            int currentDayOfWeek = (int)today.DayOfWeek;
            var currentWeekStart = today.AddDays(-currentDayOfWeek);

            // Fetch Sunday Schedules
            var activeSundaySchedules = await db.SundayScheduleMembers
                .Include(s => s.Schedule)
                .Where(s => s.MemberId == memberId && s.IsActive && s.Schedule.MassDate >= currentWeekStart)
                .OrderBy(s => s.Schedule.MassDate)
                .ToListAsync();

            if (activeSundaySchedules.Any())
            {
                // Only show the schedules for the closest upcoming/current Sunday
                var targetSunday = activeSundaySchedules.First().Schedule.MassDate;
                _memberSundaySchedules = activeSundaySchedules
                    .Where(s => s.Schedule.MassDate == targetSunday)
                    .OrderBy(s => s.Schedule.MassTime)
                    .ToList();
            }

            // Fetch Weekday Schedules
            var activeWeekdaySchedules = await db.WeekdayScheduleMembers
                .Include(w => w.Schedule)
                .Where(w => w.MemberId == memberId && w.IsActive && w.Schedule.WeekStart >= currentWeekStart)
                .OrderBy(w => w.Schedule.WeekStart)
                .ToListAsync();

            if (activeWeekdaySchedules.Any())
            {
                // Only show the schedules for the closest upcoming/current week
                var targetWeekStart = activeWeekdaySchedules.First().Schedule.WeekStart;
                _memberWeekdaySchedules = activeWeekdaySchedules
                    .Where(w => w.Schedule.WeekStart == targetWeekStart)
                    .OrderBy(w => w.Schedule.MassTime)
                    .ToList();
            }
        }

        if (AuthService.CanAccess(user, "member-dashboard") && !AuthService.CanAccess(user, "dashboard"))
        {
            return;
        }

        // Admin stats and Today's Schedule
        var todayDayOfWeek = today.DayOfWeek;
        int daysSinceSunday = (int)todayDayOfWeek;
        var currentWeekStartAdmin = today.AddDays(-daysSinceSunday);

        if (todayDayOfWeek == DayOfWeek.Sunday)
        {
            var todaySundays = await db.ScheduleSundays
                .Include(s => s.ScheduleMembers)
                .Where(s => s.MassDate == today)
                .ToListAsync();

            _todaySchedules = todaySundays.Select(s => new TodayMassInfo
            {
                Id = s.Id,
                IsSunday = true,
                Name = s.MassName,
                Time = s.MassTime.ToString("h:mm tt"),
                ServerCount = s.ScheduleMembers.Count(sm => sm.IsActive),
                TimeValue = s.MassTime
            }).OrderBy(s => s.TimeValue).ToList();
        }
        else
        {
            var dayName = todayDayOfWeek.ToString();
            var todayWeekdays = await db.ScheduleWeekdays
                .Include(s => s.ScheduleMembers)
                .Where(s => s.WeekStart == currentWeekStartAdmin && s.Day == dayName)
                .ToListAsync();

            _todaySchedules = todayWeekdays.Select(s => new TodayMassInfo
            {
                Id = s.Id,
                IsSunday = false,
                Name = $"{s.Day} - {s.MassType}",
                Time = s.MassTime.ToString("h:mm tt"),
                ServerCount = s.ScheduleMembers.Count(sm => sm.IsActive),
                TimeValue = s.MassTime
            }).OrderBy(s => s.TimeValue).ToList();
        }

        _totalMembers = await db.Members.CountAsync();
        _activeMembers = await db.Members.CountAsync(m => m.Status == "Active");
        _inactiveMembers = await db.Members.CountAsync(m => m.Status == "Inactive");
        _alumniMembers = await db.Members.CountAsync(m => m.Status == "Alumni");

        // Current week (Saturday to Friday)
        int dayOfWeek = (int)now.DayOfWeek; // 0=Sun, 6=Sat
        int daysToSat = dayOfWeek == 6 ? 0 : -(dayOfWeek + 1);
        var weekStart = DateOnly.FromDateTime(now.AddDays(daysToSat));
        var weekEnd = weekStart.AddDays(6);

        _presentThisWeek = await db.Attendances
            .Where(a => a.MeetingWeekStart >= weekStart && a.MeetingWeekStart <= weekEnd && a.Status == "Present")
            .Select(a => a.MemberId).Distinct().CountAsync();

        _absentThisWeek = await db.Attendances
            .Where(a => a.MeetingWeekStart >= weekStart && a.MeetingWeekStart <= weekEnd && a.Status == "Absent")
            .Select(a => a.MemberId).Distinct().CountAsync();

        _leaders = await db.Members
            .Include(m => m.MemberPositions.Where(mp => mp.IsCurrent))
            .ThenInclude(mp => mp.Position)
            .Where(m => m.Status == "Active" && m.MemberPositions.Any(mp => mp.IsCurrent && mp.Position.PositionName != "Member"))
            .OrderBy(m => m.LastName)
            .Take(5)
            .ToListAsync();

        // Monthly data
        for (int i = 11; i >= 0; i--)
        {
            var month = now.AddMonths(-i);
            var count = await db.Attendances
                .CountAsync(a => a.AttendanceDate.Year == month.Year && a.AttendanceDate.Month == month.Month && a.Status == "Present");
            _monthlyData.Add((month.ToString("MMM"), count));
        }

        _activePercent = _totalMembers > 0 ? (int)Math.Round(_activeMembers * 100.0 / _totalMembers) : 0;
        _inactivePercent = _totalMembers > 0 ? (int)Math.Round(_inactiveMembers * 100.0 / _totalMembers) : 0;
        _alumniPercent = _totalMembers > 0 ? (int)Math.Round(_alumniMembers * 100.0 / _totalMembers) : 0;

        // This Month's Saturday Attendance
        var daysInMonth = DateTime.DaysInMonth(now.Year, now.Month);
        for (int i = 1; i <= daysInMonth; i++)
        {
            var date = new DateOnly(now.Year, now.Month, i);
            if (date.DayOfWeek == DayOfWeek.Saturday)
            {
                _thisMonthSaturdays.Add(date.ToString("MMM dd"));
                
                var present = await db.Attendances.CountAsync(a => a.AttendanceDate == date && a.Status == "Present");
                var absent = await db.Attendances.CountAsync(a => a.AttendanceDate == date && a.Status == "Absent");
                var excused = await db.Attendances.CountAsync(a => a.AttendanceDate == date && a.Status == "Excused");
                
                _thisMonthPresent.Add(present);
                _thisMonthAbsent.Add(absent);
                _thisMonthExcused.Add(excused);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("initLucide"); } catch (Exception) { }

        if (firstRender && _monthlyData.Any())
        {
            await Task.Delay(100); // Give browser time to paint canvas
            var labels = _monthlyData.Select(d => d.Label).ToArray();
            var counts = _monthlyData.Select(d => d.Count).ToArray();
            
            var satLabels = _thisMonthSaturdays.ToArray();
            var satPresent = _thisMonthPresent.ToArray();
            var satAbsent = _thisMonthAbsent.ToArray();
            var satExcused = _thisMonthExcused.ToArray();

            await JS.InvokeVoidAsync("renderDashboardCharts", labels, counts, _activePercent, _inactivePercent, _alumniPercent, satLabels, satPresent, satAbsent, satExcused);
        }
    }

    // Modal state
    private bool _isMassModalOpen = false;
    private bool _isModalLoading = false;
    private string _modalMassTitle = string.Empty;
    private List<ServerInfo> _modalServers = new();

    private class ServerInfo
    {
        public string FullName { get; set; } = string.Empty;
        public string Initials { get; set; } = string.Empty;
        public string PrimaryRole { get; set; } = "Member";
    }

    private async Task OpenMassDetailsModal(long scheduleId, bool isSunday)
    {
        _isMassModalOpen = true;
        _isModalLoading = true;
        _modalServers.Clear();
        StateHasChanged();

        using var db = await DbFactory.CreateDbContextAsync();
        
        if (isSunday)
        {
            var sched = await db.ScheduleSundays.FirstOrDefaultAsync(s => s.Id == scheduleId);
            if (sched != null)
            {
                _modalMassTitle = $"{sched.MassName} ({sched.MassDate.ToString("MMM dd")} at {sched.MassTime.ToString("h:mm tt")})";
                
                var members = await db.SundayScheduleMembers
                    .Include(sm => sm.Member)
                    .ThenInclude(m => m.MemberPositions.Where(mp => mp.IsCurrent))
                    .ThenInclude(mp => mp.Position)
                    .Where(sm => sm.SundayScheduleId == scheduleId && sm.IsActive)
                    .Select(sm => sm.Member)
                    .ToListAsync();
                    
                _modalServers = members.Select(m => new ServerInfo
                {
                    FullName = m.FullName,
                    Initials = m.Initials,
                    PrimaryRole = m.MemberPositions.FirstOrDefault()?.Position?.PositionName ?? "Member"
                }).OrderBy(s => s.FullName).ToList();
            }
        }
        else
        {
            var sched = await db.ScheduleWeekdays.FirstOrDefaultAsync(s => s.Id == scheduleId);
            if (sched != null)
            {
                var massDate = sched.WeekStart.AddDays(sched.Day == "Monday" ? 2 : sched.Day == "Tuesday" ? 3 : sched.Day == "Wednesday" ? 4 : sched.Day == "Thursday" ? 5 : sched.Day == "Friday" ? 6 : 0);
                _modalMassTitle = $"{sched.Day} - {sched.MassType} ({massDate.ToString("MMM dd")} at {sched.MassTime.ToString("h:mm tt")})";
                
                var members = await db.WeekdayScheduleMembers
                    .Include(sm => sm.Member)
                    .ThenInclude(m => m.MemberPositions.Where(mp => mp.IsCurrent))
                    .ThenInclude(mp => mp.Position)
                    .Where(sm => sm.WeekdayScheduleId == scheduleId && sm.IsActive)
                    .Select(sm => sm.Member)
                    .ToListAsync();
                    
                _modalServers = members.Select(m => new ServerInfo
                {
                    FullName = m.FullName,
                    Initials = m.Initials,
                    PrimaryRole = m.MemberPositions.FirstOrDefault()?.Position?.PositionName ?? "Member"
                }).OrderBy(s => s.FullName).ToList();
            }
        }

        _isModalLoading = false;
        StateHasChanged();
        
        await Task.Delay(1);
        try { await JS.InvokeVoidAsync("initLucide"); } catch (Exception) { }
    }

    private void CloseMassModal()
    {
        _isMassModalOpen = false;
    }
}



