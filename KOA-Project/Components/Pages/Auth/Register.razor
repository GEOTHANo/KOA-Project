@page "/register"
@layout KOA_Project.Components.Layout.EmptyLayout
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Member Registration - Knights of the Altar</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100 font-sans selection:bg-[#246b9c] selection:text-white flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <!-- Background Glow Animations -->
    <div class="absolute inset-0 bg-[radial-gradient(#246b9c_1px,transparent_1px)] [background-size:32px_32px] opacity-15 pointer-events-none"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#246b9c]/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-2xl w-full mx-auto relative z-10">
        <!-- Navigation Header -->
        <div class="flex items-center justify-between mb-8">
            <a href="/" class="inline-flex items-center space-x-2 text-xs font-bold text-[#3892d0] hover:text-white transition-all bg-slate-900/80 hover:bg-slate-800 px-4 py-2.5 rounded-xl border border-slate-800 group shadow-md">
                <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                <span>Back to Home</span>
            </a>
            <a href="/login" class="inline-flex items-center space-x-2 text-xs font-bold text-slate-300 hover:text-white bg-slate-900/80 px-4 py-2.5 rounded-xl border border-slate-800">
                <span>Already have an account? Log In</span>
            </a>
        </div>

        <!-- Registration Card Container -->
        <div class="bg-slate-900/90 border border-slate-800 rounded-3xl shadow-2xl p-8 sm:p-10 backdrop-blur-md">
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-900/40 rounded-2xl mb-4 border border-blue-500/30">
                    <img src="/images/koa-logo.jpg" alt="KOA Logo" class="w-12 h-12 object-contain rounded-xl" />
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Knights of the Altar</h1>
                <p class="text-xs font-semibold text-amber-400 mt-1 uppercase tracking-wider">Sto. Rosario Parish &bull; Toril</p>
                <h2 class="text-lg font-bold text-slate-200 mt-4">New Member Registration</h2>
                <p class="text-xs text-slate-400 mt-1 max-w-md mx-auto">Fill out your details below to register as a new Altar Server. Your application will be reviewed for approval by system coordinators.</p>
            </div>

            @if (_isSubmitted)
            {
                <div class="bg-emerald-950/60 border border-emerald-500/40 rounded-2xl p-6 text-center space-y-4">
                    <div class="w-12 h-12 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto">
                        <i data-lucide="check-circle-2" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-lg font-bold text-emerald-300">Registration Application Submitted!</h3>
                    <p class="text-xs text-emerald-200/80 leading-relaxed max-w-md mx-auto">
                        Thank you for registering, <span class="font-bold text-white">@_model.FirstName @_model.LastName</span>! Your application has been saved and is currently <span class="text-amber-300 font-semibold">Pending Approval</span> by the Knights of the Altar officers.
                    </p>
                    <div class="pt-4 flex justify-center gap-3">
                        <a href="/login" class="px-6 py-2.5 bg-[#246b9c] hover:bg-[#1a547b] text-white font-bold text-xs rounded-xl shadow-md transition-all">
                            Go to Login Page
                        </a>
                        <a href="/" class="px-6 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs rounded-xl transition-all">
                            Return Home
                        </a>
                    </div>
                </div>
            }
            else
            {
                @if (_errors.Any())
                {
                    <div class="bg-red-950/60 border border-red-500/40 text-red-300 px-4 py-3 rounded-2xl mb-6 text-xs font-medium space-y-1">
                        @foreach (var err in _errors)
                        {
                            <div class="flex items-center space-x-2">
                                <i data-lucide="alert-circle" class="w-4 h-4 text-red-400 shrink-0"></i>
                                <span>@err</span>
                            </div>
                        }
                    </div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="space-y-5">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider">First Name <span class="text-red-400">*</span></label>
                            <InputText @bind-Value="_model.FirstName" class="w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-[#246b9c] focus:border-transparent transition-all" placeholder="e.g. Juan" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider">Middle Name</label>
                            <InputText @bind-Value="_model.MiddleName" class="w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-[#246b9c] focus:border-transparent transition-all" placeholder="e.g. Gabriel" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider">Last Name <span class="text-red-400">*</span></label>
                        <InputText @bind-Value="_model.LastName" class="w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-[#246b9c] focus:border-transparent transition-all" placeholder="e.g. Dela Cruz" />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider">Birth Date</label>
                            <InputDate @bind-Value="_model.BirthDate" class="w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-sm text-white focus:outline-none focus:ring-2 focus:ring-[#246b9c] focus:border-transparent transition-all" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider">Contact Number</label>
                            <InputText @bind-Value="_model.ContactNumber" class="w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-[#246b9c] focus:border-transparent transition-all" placeholder="09123456789" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider">Address</label>
                        <InputText @bind-Value="_model.Address" class="w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-[#246b9c] focus:border-transparent transition-all" placeholder="e.g. Toril, Davao City" />
                    </div>

                    <div class="pt-4">
                        <button type="submit" disabled="@_isSubmitting"
                                class="w-full bg-[#246b9c] hover:bg-[#1a547b] text-white font-extrabold py-3.5 px-6 rounded-xl transition-all duration-200 shadow-lg shadow-[#246b9c]/30 hover:shadow-xl transform hover:-translate-y-0.5 disabled:opacity-50 text-sm flex items-center justify-center space-x-2">
                            @if (_isSubmitting)
                            {
                                <span>Submitting Application...</span>
                            }
                            else
                            {
                                <span>Submit Registration Application &rarr;</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private RegistrationModel _model = new();
    private List<string> _errors = new();
    private bool _isSubmitting = false;
    private bool _isSubmitted = false;

    private async Task HandleSubmit()
    {
        _errors.Clear();

        if (string.IsNullOrWhiteSpace(_model.FirstName) || string.IsNullOrWhiteSpace(_model.LastName))
        {
            _errors.Add("First Name and Last Name are required.");
            return;
        }

        // Check for duplicate name in members table AND pending registrations
        using var dbCheck = await DbFactory.CreateDbContextAsync();
        var firstNameLower = _model.FirstName.Trim().ToLower();
        var lastNameLower = _model.LastName.Trim().ToLower();

        bool existsInMembers = await dbCheck.Members.AnyAsync(m =>
            m.FirstName.ToLower() == firstNameLower &&
            m.LastName.ToLower() == lastNameLower);
        if (existsInMembers)
        {
            _errors.Add($"A member named '{_model.FirstName.Trim()} {_model.LastName.Trim()}' is already registered in the system. If you believe this is an error, please contact a system coordinator.");
            return;
        }

        bool existsInPending = await dbCheck.MemberRegistrations.AnyAsync(r =>
            r.FirstName.ToLower() == firstNameLower &&
            r.LastName.ToLower() == lastNameLower &&
            r.Status == "Pending");
        if (existsInPending)
        {
            _errors.Add($"A registration application for '{_model.FirstName.Trim()} {_model.LastName.Trim()}' is already pending approval. Please wait for your application to be reviewed.");
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            var newReg = new MemberRegistration
            {
                FirstName = _model.FirstName.Trim(),
                MiddleName = _model.MiddleName?.Trim(),
                LastName = _model.LastName.Trim(),
                BirthDate = _model.BirthDate,
                ContactNumber = _model.ContactNumber?.Trim(),
                Address = _model.Address?.Trim(),
                Status = "Pending",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            db.MemberRegistrations.Add(newReg);
            await db.SaveChangesAsync();

            _isSubmitted = true;
        }
        catch (Exception ex)
        {
            _errors.Add("Failed to submit registration: " + ex.Message);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
            try { await JS.InvokeVoidAsync("initLucide"); } catch (Exception) { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("initLucide"); } catch (Exception) { }
        }
    }

    public class RegistrationModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string? MiddleName { get; set; }
        public string LastName { get; set; } = string.Empty;
        public DateOnly? BirthDate { get; set; }
        public string? ContactNumber { get; set; }
        public string? Address { get; set; }
    }
}